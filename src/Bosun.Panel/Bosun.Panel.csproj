<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Culture-aware bindings (dates, numbers, sizes) need ICU, so the panel never runs invariant. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- asInvoker and per-monitor DPI v2 (D02 T02 §1): embedded in Bosun.Panel.exe. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The program's icon (design/SPEC.md §18), generated from the masters by scripts/build-icons.py. -->
    <ApplicationIcon>..\..\resources\bosun.ico</ApplicationIcon>
    <!-- Program.Main chooses helper mode (the optimise switch) before App exists (D05 T02 §6), so App.xaml is a page, not the definition. -->
    <StartupObject>Bosun.Panel.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bosun.Core\Bosun.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lucide glyphs, drawn as vectors (design/SPEC.md §19), named only through Theme/Glyphs.cs (D02 T03 §3). -->
    <PackageReference Include="MahApps.Metro.IconPacks.Lucide" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same icon inside the panel, for its window and the title bar. -->
    <Resource Include="..\..\resources\bosun.ico" Link="Resources\bosun.ico" />
    <!-- The tray's three icons (D02 T02 §7), read by Win32TrayShell.LoadIcon as Bosun.Panel.Tray.tray-*.ico. -->
    <EmbeddedResource Include="..\..\resources\tray-*.ico" LogicalName="Bosun.Panel.Tray.%(Filename)%(Extension)" Link="Resources\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests reach the helpers' test seams (LiveRegion.Raising, SelectionGuard.Target). -->
    <InternalsVisibleTo Include="Bosun.Panel.Tests" />
  </ItemGroup>
</Project>
