<!-- The Memory page's content (D03 T01 §2, design/SPEC.md §3, the mockup's Memory page): three cards, Windows used, WSL
     VM and Overlapping builds, each a value and a note, then the By repo table, sortable by its number columns. A value
     that can't be read is drawn through the Value style as "Not available" with why. Drawn in the page frame through
     the implicit DataTemplate for MemoryPage (PageFrame.xaml), which is its DataContext. -->
<UserControl x:Class="Bosun.Panel.Memory.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:controls="clr-namespace:Bosun.Panel.Controls"
             xmlns:theme="clr-namespace:Bosun.Panel.Theme"
             xmlns:memory="clr-namespace:Bosun.Panel.Memory"
             Focusable="False">
    <UserControl.Resources>
        <!-- A card as the mockup draws one: the surface, a line, and its corners. -->
        <Style x:Key="MemoryCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource B.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource R.Card}"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource F.Display}"/>
            <Setter Property="FontSize" Value="{DynamicResource T.Metric}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource T.Caption}"/>
            <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Warning" TargetType="TextBlock" BasedOn="{StaticResource Note}">
            <Setter Property="Foreground" Value="{DynamicResource B.Warn}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- A card's value, large; a NotAvailable beside it takes the theme's own template, "Not available" with why. -->
        <DataTemplate DataType="{x:Type memory:Metric}">
            <TextBlock Text="{Binding Text}" Style="{StaticResource Metric}"/>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock x:Name="HistoryNote" Text="{Binding HistoryNote}" Style="{StaticResource Warning}"/>
        <UniformGrid Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource MemoryCard}" Margin="0,0,8,0" AutomationProperties.Name="Windows used">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <controls:Decorative Margin="0,0,8,0" VerticalAlignment="Center">
                            <icons:PackIconLucide Kind="{x:Static theme:Glyphs.WindowsMemory}" Width="15" Height="15" Focusable="False"
                                                  Foreground="{DynamicResource B.TextDim}"/>
                        </controls:Decorative>
                        <TextBlock Text="Windows used" Style="{StaticResource CardTitle}"/>
                    </StackPanel>
                    <ContentControl x:Name="WindowsUsed" Content="{Binding WindowsUsed}" Style="{DynamicResource Value}"/>
                    <TextBlock x:Name="WindowsNote" Text="{Binding WindowsNote}" Style="{StaticResource Note}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MemoryCard}" Margin="4,0" AutomationProperties.Name="WSL VM">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <controls:Decorative Margin="0,0,8,0" VerticalAlignment="Center">
                            <icons:PackIconLucide Kind="{x:Static theme:Glyphs.WslMemory}" Width="15" Height="15" Focusable="False"
                                                  Foreground="{DynamicResource B.TextDim}"/>
                        </controls:Decorative>
                        <TextBlock Text="WSL VM" Style="{StaticResource CardTitle}"/>
                    </StackPanel>
                    <ContentControl x:Name="WslVm" Content="{Binding WslVm}" Style="{DynamicResource Value}"/>
                    <TextBlock x:Name="WslNote" Text="{Binding WslNote}" Style="{StaticResource Note}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MemoryCard}" Margin="8,0,0,0" AutomationProperties.Name="Overlapping builds">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <controls:Decorative Margin="0,0,8,0" VerticalAlignment="Center">
                            <icons:PackIconLucide Kind="{x:Static theme:Glyphs.Builds}" Width="15" Height="15" Focusable="False"
                                                  Foreground="{DynamicResource B.TextDim}"/>
                        </controls:Decorative>
                        <TextBlock Text="Overlapping builds" Style="{StaticResource CardTitle}"/>
                    </StackPanel>
                    <ContentControl x:Name="Overlap" Content="{Binding Overlap}" Style="{DynamicResource Value}"/>
                    <TextBlock x:Name="OverlapNote" Text="{Binding OverlapNote}" Style="{StaticResource Note}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource MemoryCard}">
            <StackPanel>
                <TextBlock Text="By repo" Style="{StaticResource CardTitle}" Margin="0,0,0,10" AutomationProperties.HeadingLevel="Level2"/>
                <TextBlock x:Name="WslAge" Text="{Binding WslAge}" Style="{StaticResource Warning}"/>
                <TextBlock x:Name="PeaksNote" Text="{Binding PeaksNote}" Style="{StaticResource Warning}"/>
                <DataGrid x:Name="ByRepo" ItemsSource="{Binding RowsView}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserSortColumns="True" AutomationProperties.Name="By repo">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Repo" Binding="{Binding Repo}" SortMemberPath="Repo" Width="2*"
                                            ElementStyle="{DynamicResource Cell.Text}"/>
                        <DataGridTextColumn Header="Side" Binding="{Binding Side}" SortMemberPath="Side" Width="*"
                                            ElementStyle="{DynamicResource Cell.Text}"/>
                        <DataGridTextColumn Header="Private GB" Binding="{Binding Private}" SortMemberPath="PrivateGb" Width="*"
                                            ElementStyle="{DynamicResource Cell.Number}"/>
                        <DataGridTextColumn Header="Peak GB" Binding="{Binding Peak}" SortMemberPath="PeakGb" Width="1.4*"
                                            ElementStyle="{DynamicResource Cell.Number}"/>
                        <DataGridTextColumn Header="Processes" Binding="{Binding ProcessesNow}" SortMemberPath="Processes" Width="*"
                                            ElementStyle="{DynamicResource Cell.Number}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="TableNote" Text="{Binding TableNote}" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
