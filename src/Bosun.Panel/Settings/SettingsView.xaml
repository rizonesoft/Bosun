<!-- The Settings page's content (D02 T02 §5 and §7, design/SPEC.md §15, General): the theme, Start with Windows,
     notifications by type, Save and Discard, and a line saying what the last save did. Drawn in the page frame through the implicit DataTemplate
     for SettingsPage (PageFrame.xaml), which is its DataContext. Every resource is named with DynamicResource. -->
<UserControl x:Class="Bosun.Panel.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:theme="clr-namespace:Bosun.Panel.Theme"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="clr-namespace:Bosun.Panel.Accessibility"
             xmlns:controls="clr-namespace:Bosun.Panel.Controls"
             Focusable="False">
    <!-- The form's readable width (Size.Form) at most, and the window's width when that is less: a star column capped
         by it, where a capped width aligned left shrank to its content (D02 T04 §3). -->
    <Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="{DynamicResource Size.Form}"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <StackPanel>
        <!-- The settings file could not be read as settings: it was kept, and the defaults are in use. -->
        <TextBlock x:Name="Notice" Text="{Binding Notice}" Foreground="{DynamicResource B.Warn}" TextWrapping="Wrap"
                   Margin="{DynamicResource Gap.Below.L}" a:LiveRegion.Announce="True">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Two cards, General and Notifications, a readable width and the scale's XL apart (D02 T04 §3). -->
        <Border x:Name="GeneralCard" Style="{DynamicResource Card}">
        <StackPanel>
        <TextBlock x:Name="GeneralHeading" Text="General" Style="{DynamicResource Section.Heading}"/>

        <TextBlock x:Name="ThemeLabel" Text="Theme" Style="{DynamicResource FieldLabel}"/>
        <!-- The three-way choice side by side (D02 T03 §4, design/SPEC.md §19 Segmented control): one press, or the arrow keys. -->
        <controls:SegmentedControl x:Name="ThemeBox" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                   DisplayMemberPath="Name" AutomationProperties.Name="Theme"
                                   ToolTip="Follow Windows, or always dark or light. Applies when saved, with no restart."/>
        <!-- While Windows draws in a contrast theme (D02 T03 §10): why the choice above changes nothing yet. -->
        <TextBlock x:Name="ThemeNote" Text="{Binding ThemeNote}" Foreground="{DynamicResource B.TextDim}" TextWrapping="Wrap"
                   Margin="{DynamicResource Gap.Above.S}" a:LiveRegion.Announce="True">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ThemeNote}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <CheckBox x:Name="StartWithWindows" Content="Start with Windows, in the tray" Margin="{DynamicResource Gap.Above.L}"
                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}" HorizontalAlignment="Left"
                  ToolTip="Starts Bosun Panel in the tray when you sign in to Windows."/>

        <!-- The entry is not simply on or off (Windows has it turned off, it starts another copy, or it could not be
             read again): said in words, with the way out. -->
        <StackPanel x:Name="StartupOff" Margin="{DynamicResource Gap.Above.S}">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StartupNote}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock x:Name="StartupNote" Text="{Binding StartupNote}" Foreground="{DynamicResource B.Warn}"
                       TextWrapping="Wrap" a:LiveRegion.Announce="True"/>
            <!-- The way out of what the line says: Windows' own settings, this copy in place of another, or reading again. -->
            <Button x:Name="StartupAction" Content="{Binding StartupActionName}" Style="{DynamicResource Btn}"
                    Command="{Binding StartupAction}" HorizontalAlignment="Left" Margin="{DynamicResource Gap.Above.S}"/>
        </StackPanel>

        <!-- The pressure alert threshold (D03 T01 §4, design/SPEC.md §15): what can't be one is refused beside it. -->
        <StackPanel Margin="{DynamicResource Gap.Above.L}">
        <TextBlock x:Name="FloorLabel" Text="Pressure alert threshold" Style="{DynamicResource FieldLabel}"/>
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="PressureFloor" Text="{Binding PressureFloorText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource Field}"
                     theme:FieldState.Invalid="{Binding HasPressureFloorError}"
                     Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Pressure alert threshold, in MB"
                     AutomationProperties.HelpText="{Binding PressureFloorError}"
                     ToolTip="A notification when Windows' available memory falls under this, from 512 to 65536 MB."/>
            <TextBlock Text="MB available" Foreground="{DynamicResource B.TextDim}" VerticalAlignment="Center" Margin="{DynamicResource Gap.Before.S}"/>
        </StackPanel>
        <TextBlock x:Name="FloorError" Text="{Binding PressureFloorError}" Foreground="{DynamicResource B.Danger}" TextWrapping="Wrap"
                   Margin="{DynamicResource Gap.Above.S}" a:LiveRegion.Announce="True">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PressureFloorError}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        </StackPanel>
        </StackPanel>
        </Border>

        <Border x:Name="NotificationsCard" Style="{DynamicResource Card}" Margin="{DynamicResource Gap.Above.XL}">
        <StackPanel>
        <TextBlock x:Name="NotificationsHeading" Text="Notifications" Style="{DynamicResource Section.Heading}"/>
        <CheckBox x:Name="NotifyMemoryPressure" Content="Notify me about memory pressure"
                  IsChecked="{Binding NotifyMemoryPressure, Mode=TwoWay}" HorizontalAlignment="Left"
                  ToolTip="Shows a Windows notification when memory runs short. It is written to the Activity pane either way."/>

        </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="{DynamicResource Gap.Above.XL}">
            <Button x:Name="Save" Content="Save" Style="{DynamicResource Btn.Primary}" Command="{Binding Save}"
                    ToolTip="Saves the settings on this page and reads them back"/>
            <Button x:Name="Discard" Content="Discard" Style="{DynamicResource Btn}" Command="{Binding DiscardChanges}"
                    Margin="{DynamicResource Gap.Before.S}" ToolTip="Puts the page back to what is stored"/>
        </StackPanel>

        <!-- What the last save did: said aloud when it changes. -->
        <TextBlock x:Name="Status" Text="{Binding Status}" Foreground="{DynamicResource B.TextDim}" TextWrapping="Wrap"
                   Margin="{DynamicResource Gap.Above.M}" a:LiveRegion.Announce="True"/>
    </StackPanel>
    </Grid>
</UserControl>
