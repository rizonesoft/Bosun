<!-- Everything inside the panel's window (D02 T02 §4, design/SPEC.md §1): the 44 px title bar, the 208 px rail, the
     page on its sheet, and the Activity pane. It is a control, not the window, so it can be drawn off screen for
     review and driven by tests with no window on the desktop; MainWindow is the window around it. Its DataContext is
     the ShellViewModel.

     Every resource is named with DynamicResource: off screen there is no application to look a StaticResource up
     in, and the theme is swapped live. -->
<UserControl x:Class="Bosun.Panel.Shell.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Bosun.Panel.Shell"
             xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             FontFamily="{DynamicResource F.Ui}" FontSize="{DynamicResource T.Body}"
             Foreground="{DynamicResource B.Text}" Background="{DynamicResource B.Base}"
             Focusable="False">
    <Grid>
        <Grid x:Name="Body">
            <Grid.Style>
                <!-- Under the question about unsaved changes, nothing else can be reached. -->
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAsking}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar. The window drags by it; the three buttons are marked as the window's own to click. -->
            <Grid x:Name="TitleBar" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="AppIcon" Grid.Column="0" Width="20" Height="20" Margin="16,0,10,0" VerticalAlignment="Center"
                       AutomationProperties.Name="Bosun"/>
                <TextBlock x:Name="AppTitle" Grid.Column="1" Text="Bosun Panel" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel x:Name="WindowButtons" Grid.Column="3" Orientation="Horizontal"
                            chrome:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="Minimise" Style="{DynamicResource Btn.Chrome}" AutomationProperties.Name="Minimise"
                            ToolTip="Minimise" Click="OnMinimise">
                        <Path Data="M0,0 L10,0" StrokeThickness="1" SnapsToDevicePixels="True"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="Maximise" Style="{DynamicResource Btn.Chrome}" AutomationProperties.Name="Maximise"
                            ToolTip="Maximise" Click="OnMaximise">
                        <Path x:Name="MaximiseMark" Data="M0,0 H10 V10 H0 Z" StrokeThickness="1" SnapsToDevicePixels="True"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{DynamicResource Btn.Chrome}" Tag="danger"
                            AutomationProperties.Name="Close" ToolTip="Close" Click="OnClose">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1" SnapsToDevicePixels="True"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="208"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Rail: the pages under their group headings. -->
                <ListBox x:Name="Rail" Grid.Column="0" Style="{DynamicResource NavList}" Margin="8,0,8,12"
                         AutomationProperties.Name="Pages" TextSearch.TextPath="Title">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{DynamicResource T.SectionLabel}" Margin="12,14,0,4"
                                               AutomationProperties.HeadingLevel="Level2"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <!-- A rail row: the page's title. The glyph before it and the count badge after it are
                             D02 T03 §3's, which fills these two slots. -->
                        <DataTemplate DataType="{x:Type shell:Section}">
                            <DockPanel>
                                <ContentControl x:Name="Glyph" DockPanel.Dock="Left" Focusable="False"/>
                                <ContentControl x:Name="Badge" DockPanel.Dock="Right" Focusable="False"/>
                                <TextBlock x:Name="RowTitle" Text="{Binding Title}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- The sheet the page sits on: set apart by a line with a rounded top-left corner. The border runs
                     past the right and bottom edges, where the clip cuts it, so only that one corner is round and
                     the radius stays the theme's own (R.Sheet). -->
                <Grid Grid.Column="1" ClipToBounds="True">
                    <Border x:Name="Sheet" Margin="0,0,-32,-32" Background="{DynamicResource B.Base}"
                            BorderBrush="{DynamicResource B.Line}" BorderThickness="1"
                            CornerRadius="{DynamicResource R.Sheet}">
                        <Grid Margin="0,0,32,32">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="120"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition x:Name="PaneRow" Height="132" MinHeight="64" MaxHeight="400"/>
                            </Grid.RowDefinitions>

                            <shell:PageFrame x:Name="PageHost" Grid.Row="0" DataContext="{Binding Page}" Margin="26,22,26,12"/>

                            <!-- Dragged, or moved with the arrow keys, to resize the Activity pane within the
                                 row's limits. -->
                            <GridSplitter x:Name="PaneSplitter" Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" KeyboardIncrement="16"
                                          Background="Transparent" Cursor="SizeNS" Focusable="True"
                                          FocusVisualStyle="{DynamicResource FocusRing.Inside}"
                                          AutomationProperties.Name="Resize the Activity pane"
                                          ToolTip="Drag, or use the arrow keys, to resize the Activity pane"/>

                            <Border Grid.Row="2" BorderBrush="{DynamicResource B.Line}" BorderThickness="0,1,0,0">
                                <ListBox x:Name="Activity" Style="{DynamicResource LogBox}" ItemsSource="{Binding Activity}"
                                         Margin="10,6,0,6" AutomationProperties.Name="Activity"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <shell:LeaveDialog x:Name="Leave">
            <shell:LeaveDialog.Style>
                <Style TargetType="shell:LeaveDialog">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAsking}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </shell:LeaveDialog.Style>
        </shell:LeaveDialog>
    </Grid>
</UserControl>
