<!-- Everything inside the panel's window (D02 T02 §4, design/SPEC.md §1): the 44 px title bar, the 208 px rail, the
     page on its sheet, and the Activity pane. It is a control, not the window, so it can be drawn off screen for
     review and driven by tests with no window on the desktop; MainWindow is the window around it. Its DataContext is
     the ShellViewModel.

     Every resource is named with DynamicResource: off screen there is no application to look a StaticResource up
     in, and the theme is swapped live. -->
<UserControl x:Class="Bosun.Panel.Shell.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Bosun.Panel.Theme"
             xmlns:shell="clr-namespace:Bosun.Panel.Shell"
             xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:controls="clr-namespace:Bosun.Panel.Controls"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             FontFamily="{DynamicResource F.Ui}" FontSize="{DynamicResource T.Body}"
             Foreground="{DynamicResource B.Text}" Background="{DynamicResource B.Base}"
             Focusable="False">
    <UserControl.Resources>
        <shell:PageGlyph x:Key="PageGlyph"/>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="Body">
            <Grid.Style>
                <!-- Under the question about unsaved changes, nothing else can be reached. -->
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAsking}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar. The window drags by it; the three buttons are marked as the window's own to click. -->
            <Grid x:Name="TitleBar" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="AppIcon" Grid.Column="0" Width="20" Height="20" Margin="16,0,10,0" VerticalAlignment="Center"
                       AutomationProperties.Name="Bosun"/>
                <TextBlock x:Name="AppTitle" Grid.Column="1" Text="Bosun Panel" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel x:Name="WindowButtons" Grid.Column="3" Orientation="Horizontal"
                            chrome:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="Minimise" Style="{DynamicResource Btn.Chrome}" AutomationProperties.Name="Minimise"
                            ToolTip="Minimise" Click="OnMinimise">
                        <Path Data="M0,0 L10,0" StrokeThickness="1" SnapsToDevicePixels="True"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="Maximise" Style="{DynamicResource Btn.Chrome}" AutomationProperties.Name="Maximise"
                            ToolTip="Maximise" Click="OnMaximise">
                        <Path x:Name="MaximiseMark" Data="M0,0 H10 V10 H0 Z" StrokeThickness="1" SnapsToDevicePixels="True"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{DynamicResource Btn.Chrome}" Tag="danger"
                            AutomationProperties.Name="Close" ToolTip="Close" Click="OnClose">
                        <Path x:Name="CloseGlyph" Data="{x:Static theme:Glyphs.CaptionClose}" StrokeThickness="1" SnapsToDevicePixels="True"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="208"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Rail: the pages under their group headings. -->
                <ListBox x:Name="Rail" Grid.Column="0" Style="{DynamicResource NavList}" Margin="8,0,8,12"
                         AutomationProperties.Name="Pages" TextSearch.TextPath="Title">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{DynamicResource T.SectionLabel}" Margin="12,14,0,4"
                                               AutomationProperties.HeadingLevel="Level2"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <!-- A rail row (D02 T03 §3): the page's glyph, from the one icon map, in the row's own
                             colour (dim, the accent when selected, the highlight's text in a contrast theme); its title;
                             and its count badge while the page has something waiting or needing the person. The glyph and the badge are
                             decorative: the row's name says the title and the count, once (ShellView.RowStyle). -->
                        <DataTemplate DataType="{x:Type shell:Section}">
                            <DockPanel>
                                <controls:Decorative x:Name="Glyph" DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <icons:PackIconLucide Kind="{Binding Key, Converter={StaticResource PageGlyph}}"
                                                          Width="16" Height="16" Focusable="False" IsTabStop="False"
                                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                </controls:Decorative>
                                <controls:Decorative x:Name="Badge" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Border Style="{DynamicResource CountBadge}">
                                        <TextBlock Text="{Binding Page.Badge}"/>
                                    </Border>
                                </controls:Decorative>
                                <TextBlock x:Name="RowTitle" Text="{Binding Title}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <!-- A count only when the page has something waiting, or something that needs the person
                                     there (design/SPEC.md §19, D03 T01 §5). -->
                                <DataTrigger Binding="{Binding Page.Badge}" Value="0">
                                    <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- The sheet the page sits on: set apart by a line with a rounded top-left corner. The border runs
                     past the right and bottom edges, where the clip cuts it, so only that one corner is round and
                     the radius stays the theme's own (R.Sheet). -->
                <Grid Grid.Column="1" ClipToBounds="True">
                    <Border x:Name="Sheet" Margin="0,0,-32,-32" Background="{DynamicResource B.Base}"
                            BorderBrush="{DynamicResource B.Line}" BorderThickness="1"
                            CornerRadius="{DynamicResource R.Sheet}">
                        <!-- 31, not 32: the border's own 1 px is already inside the 32 the sheet runs over by. -->
                        <Grid Margin="0,0,31,31">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="120"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition x:Name="PaneRow" Height="132" MinHeight="64" MaxHeight="400"/>
                            </Grid.RowDefinitions>

                            <!-- The page fills the space it has. When that is less than a page needs (the window at
                                 its smallest with the Activity pane at its largest), the page keeps its least height
                                 and this scrolls, so nothing on it, Retry least of all, is out of reach. -->
                            <ScrollViewer x:Name="PageScroll" Grid.Row="0" Padding="26,22,26,12" Focusable="False"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <shell:PageFrame x:Name="PageHost" DataContext="{Binding Page}" MinHeight="320"
                                                 Height="{Binding ViewportHeight, ElementName=PageScroll}"/>
                            </ScrollViewer>

                            <!-- Dragged, or moved with the arrow keys, to resize the Activity pane within the
                                 row's limits. -->
                            <!-- A 32 px target (design/SPEC.md §1) on an 8 px row: it reaches 12 px over the page's
                                 bottom margin and 12 px over the pane's top, drawn above both, and draws nothing. -->
                            <GridSplitter x:Name="PaneSplitter" Grid.Row="1" Height="32" Margin="0,-12" Panel.ZIndex="1"
                                          HorizontalAlignment="Stretch"
                                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" KeyboardIncrement="16"
                                          Background="Transparent" Cursor="SizeNS" Focusable="True"
                                          FocusVisualStyle="{DynamicResource FocusRing.Inside}"
                                          AutomationProperties.Name="Resize the Activity pane"
                                          ToolTip="Drag, or use the arrow keys, to resize the Activity pane"/>

                            <!-- The pane says what it is (D02 T04 §9): a heading a screen reader finds as one, over its log. -->
                            <Border x:Name="ActivityPane" Grid.Row="2" BorderBrush="{DynamicResource B.Line}" BorderThickness="0,1,0,0">
                                <!-- At the pane's least height, 64 px (PanelSettings.MinActivityPaneHeight), the line above it, the
                                     heading and a 32 px log with one whole line fit: 1 + 4 + 19 + 4 + 32 + 4. So the insets are the
                                     space scale's XS, and so is the heading's gap below, where a page's section heading has M. -->
                                <Grid Margin="10,4,0,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="ActivityHeading" Text="Activity" Style="{DynamicResource Section.Heading}"
                                               Margin="{DynamicResource Gap.Below.XS}"/>
                                    <ListBox x:Name="Activity" Grid.Row="1" Style="{DynamicResource LogBox}" ItemsSource="{Binding Activity}"
                                             AutomationProperties.Name="Activity"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- The command palette (D02 T03 §8), under the question about unsaved edits: it closes before that is asked. -->
        <!-- The toasts (D02 T03 §9): bottom right, newest last, and how many more are only in the Activity pane. -->
        <StackPanel x:Name="ToastStack" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20">
            <ItemsControl x:Name="Toasts" ItemsSource="{Binding Toasts.Shown}" Focusable="False" IsTabStop="False"
                          AutomationProperties.Name="Results">
                <!-- Each toast's list item says what it is ("Failed: ..."), not its type's name (D02 T04 §7). -->
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <shell:ToastCard Margin="0,8,0,0" Host="{Binding DataContext.Toasts, RelativeSource={RelativeSource AncestorType=shell:ShellView}}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Announced as it changes: a result not shown as a toast is still said to be there (completion review). -->
            <TextBlock x:Name="ToastOverflow" Text="{Binding Toasts.OverflowText}" HorizontalAlignment="Right" Margin="0,6,4,0"
                       Foreground="{DynamicResource B.TextDim}" FontSize="{DynamicResource T.Caption}"
                       xmlns:a="clr-namespace:Bosun.Panel.Accessibility" a:LiveRegion.Announce="True"/>
        </StackPanel>

        <shell:CommandPaletteView x:Name="PaletteView" DataContext="{Binding Palette}"/>

        <shell:LeaveDialog x:Name="Leave">
            <shell:LeaveDialog.Style>
                <Style TargetType="shell:LeaveDialog">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAsking}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </shell:LeaveDialog.Style>
        </shell:LeaveDialog>
    </Grid>
</UserControl>
