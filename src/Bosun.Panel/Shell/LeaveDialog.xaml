<!-- The question asked when a page with unsaved changes is being left (D02 T02 §4, design/SPEC.md §1): Save,
     Discard or Keep editing. It is drawn over the shell, inside the window, while the shell's Asking is set; the
     shell's frame is disabled under it, so nothing behind it can be reached. Its DataContext is the ShellViewModel.
     A screen reader meets it as a dialog named Unsaved changes, with the question as its text: the name and the
     dialog mark are on this control, the one element of the question that UI Automation has a peer for. -->
<UserControl x:Class="Bosun.Panel.Shell.LeaveDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" AutomationProperties.Name="Unsaved changes" AutomationProperties.IsDialog="True">
    <Grid>
        <!-- The page behind stays visible, dimmed: the person sees what they are being asked about. -->
        <Border x:Name="Scrim" Background="{DynamicResource B.Base}" Opacity="0.72"/>

        <Border x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Padding="24"
                Background="{DynamicResource B.Raised}" BorderBrush="{DynamicResource B.LineStrong}" BorderThickness="1"
                CornerRadius="{DynamicResource R.Overlay}"
                KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
            <StackPanel>
                <TextBlock x:Name="Question" FontSize="{DynamicResource T.Subtitle}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="{Binding Asking.PageTitle, StringFormat='Save your changes to {0}?'}"/>
                <TextBlock x:Name="Consequence" Foreground="{DynamicResource B.TextDim}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="This page has changes that are not saved. Leaving it without saving loses them."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="Keep" Content="Keep editing" Style="{DynamicResource Btn}" IsCancel="True"
                            Click="OnKeep"/>
                    <Button x:Name="Discard" Content="Discard" Style="{DynamicResource Btn.Danger}" Margin="8,0,0,0"
                            Click="OnDiscard"/>
                    <Button x:Name="Save" Content="Save" Style="{DynamicResource Btn.Primary}" IsDefault="True"
                            Margin="8,0,0,0" Click="OnSave"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
