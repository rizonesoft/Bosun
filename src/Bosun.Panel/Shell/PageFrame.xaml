<!-- The one control every page is drawn in (D02 T02 §4, design/SPEC.md §1): the header, and under it exactly one of
     the page's four states. Its DataContext is the page (PageBase). A page's own content is drawn by the implicit
     DataTemplate for its type, so a page never draws a header or a state of its own.

     Every resource is named with DynamicResource: the view is also drawn off screen, where there is no application
     to look a StaticResource up in, and the theme is swapped live. -->
<UserControl x:Class="Bosun.Panel.Shell.PageFrame"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="clr-namespace:Bosun.Panel.Accessibility"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: the title, what the page is for, and the page's own actions at the right. -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="PageTitle" Text="{Binding Title}" FontFamily="{DynamicResource F.Display}"
                           FontSize="{DynamicResource T.Title}" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock x:Name="PageSummary" Text="{Binding Summary}" Foreground="{DynamicResource B.TextDim}"
                           Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <ContentControl x:Name="PageActions" Grid.Column="1" Content="{Binding Actions}" Focusable="False"
                            VerticalAlignment="Top" Margin="12,0,0,0"/>
        </Grid>

        <!-- Why a save asked for on the way out did not happen: said aloud, and kept until one does. -->
        <TextBlock x:Name="SaveFailure" Grid.Row="1" Text="{Binding SaveFailure}" Foreground="{DynamicResource B.Danger}"
                   TextWrapping="Wrap" Margin="0,0,0,12" a:LiveRegion.Announce="True">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SaveFailure}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Data: the page itself, through the DataTemplate for its type. -->
        <ContentControl x:Name="Data" Grid.Row="2" Content="{Binding}" Focusable="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Data">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- Loading: words here; the skeleton shaped like the page's data is D02 T03 §7's. -->
        <TextBlock x:Name="Loading" Grid.Row="2" Text="Loading" Foreground="{DynamicResource B.TextDim}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Loading">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Empty: why there is nothing, and what to do. -->
        <StackPanel x:Name="Empty" Grid.Row="2" MaxWidth="560" HorizontalAlignment="Left">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Empty">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock x:Name="EmptyReason" Text="{Binding EmptyReason}" FontSize="{DynamicResource T.Subtitle}"
                       FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="EmptyAction" Text="{Binding EmptyAction}" Foreground="{DynamicResource B.TextDim}"
                       Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Failed: the tool's own message, quoted, and Retry. -->
        <StackPanel x:Name="Failed" Grid.Row="2" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Failed">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock x:Name="FailedHeading" Text="This did not work" FontSize="{DynamicResource T.Subtitle}"
                       FontWeight="SemiBold" Foreground="{DynamicResource B.Danger}"/>
            <TextBlock x:Name="FailureMessage" Text="{Binding FailureMessage}" Style="{DynamicResource T.Mono}"
                       Foreground="{DynamicResource B.Text}" Margin="0,6,0,0" TextWrapping="Wrap"
                       a:LiveRegion.Announce="True"/>
            <Button x:Name="Retry" Content="Retry" Command="{Binding Retry}" Style="{DynamicResource Btn}"
                    HorizontalAlignment="Left" Margin="0,14,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
