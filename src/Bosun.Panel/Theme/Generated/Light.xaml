<!-- Generated by scripts/build-theme.py from design/tokens/colors.json. Do not edit: change the tokens and run the script. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Colours -->
    <Color x:Key="C.Base">#F4F6F8</Color>
    <Color x:Key="C.Surface">#FFFFFF</Color>
    <Color x:Key="C.Raised">#ECEFF3</Color>
    <Color x:Key="C.Hover">#E2E7ED</Color>
    <Color x:Key="C.Line">#CCD3DC</Color>
    <Color x:Key="C.Text">#141A22</Color>
    <Color x:Key="C.TextDim">#465160</Color>
    <Color x:Key="C.TextMute">#5A6676</Color>
    <Color x:Key="C.Accent">#0A7A5E</Color>
    <Color x:Key="C.AccentDim">#CFEFE5</Color>
    <Color x:Key="C.OnAccent">#FFFFFF</Color>
    <Color x:Key="C.Ok">#16703A</Color>
    <Color x:Key="C.Warn">#8F5A00</Color>
    <Color x:Key="C.Danger">#C2281C</Color>
    <Color x:Key="C.Info">#1F5FBF</Color>
    <Color x:Key="C.LineStrong">#B5BEC9</Color>
    <Color x:Key="C.OkSoft">#1216703A</Color>
    <Color x:Key="C.WarnSoft">#128F5A00</Color>
    <Color x:Key="C.DangerSoft">#12C2281C</Color>
    <Color x:Key="C.InfoSoft">#121F5FBF</Color>

    <!-- Brushes, frozen: they never change, so WPF can share them across threads and skip change tracking -->
    <SolidColorBrush x:Key="B.Base" Color="{StaticResource C.Base}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.Raised" Color="{StaticResource C.Raised}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.Hover" Color="{StaticResource C.Hover}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.Line" Color="{StaticResource C.Line}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.TextDim" Color="{StaticResource C.TextDim}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.TextMute" Color="{StaticResource C.TextMute}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.AccentDim" Color="{StaticResource C.AccentDim}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.OnAccent" Color="{StaticResource C.OnAccent}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.Ok" Color="{StaticResource C.Ok}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.Warn" Color="{StaticResource C.Warn}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.Info" Color="{StaticResource C.Info}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.LineStrong" Color="{StaticResource C.LineStrong}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.OkSoft" Color="{StaticResource C.OkSoft}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.WarnSoft" Color="{StaticResource C.WarnSoft}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.DangerSoft" Color="{StaticResource C.DangerSoft}" po:Freeze="True"/>
    <SolidColorBrush x:Key="B.InfoSoft" Color="{StaticResource C.InfoSoft}" po:Freeze="True"/>

    <!-- Corner radii -->
    <CornerRadius x:Key="R.Card">12</CornerRadius>
    <CornerRadius x:Key="R.Control">8</CornerRadius>
    <CornerRadius x:Key="R.Sheet">12</CornerRadius>
    <CornerRadius x:Key="R.Overlay">14</CornerRadius>
    <CornerRadius x:Key="R.Pill">999</CornerRadius>
    <CornerRadius x:Key="R.Mark">4</CornerRadius>

    <!-- Spacing -->
    <sys:Double x:Key="S.XS">4</sys:Double>
    <sys:Double x:Key="S.S">8</sys:Double>
    <sys:Double x:Key="S.M">12</sys:Double>
    <sys:Double x:Key="S.L">16</sys:Double>
    <sys:Double x:Key="S.XL">24</sys:Double>

    <!-- Type sizes -->
    <sys:Double x:Key="T.Caption">11</sys:Double>
    <sys:Double x:Key="T.Body">13</sys:Double>
    <sys:Double x:Key="T.Subtitle">15</sys:Double>
    <sys:Double x:Key="T.Title">21</sys:Double>
    <sys:Double x:Key="T.Metric">28</sys:Double>

    <!-- Elevation: a shadow straight down, black, at this theme's opacity; frozen, so it is shared and never re-tracked -->
    <DropShadowEffect x:Key="Elevation.Card" BlurRadius="20" ShadowDepth="6" Direction="270" Color="#FF000000" Opacity="0.07" po:Freeze="True"/>
    <DropShadowEffect x:Key="Elevation.Overlay" BlurRadius="44" ShadowDepth="16" Direction="270" Color="#FF000000" Opacity="0.18" po:Freeze="True"/>

    <!-- Motion: the design's durations and easing. Read through Theme/Motion.cs, which gives zero when Windows' animation effects are off -->
    <Duration x:Key="Motion.Fast">0:0:0.120</Duration>
    <Duration x:Key="Motion.Normal">0:0:0.220</Duration>
    <Duration x:Key="Motion.Slow">0:0:0.400</Duration>
    <Duration x:Key="Motion.Pulse">0:0:2.400</Duration>
    <KeySpline x:Key="Motion.Ease" ControlPoint1="0.2,0.8" ControlPoint2="0.2,1" po:Freeze="True"/>
</ResourceDictionary>
