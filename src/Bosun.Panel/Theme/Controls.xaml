<!-- The panel's control styles (D02 T01 §4), after Steward's Theme/Controls.xaml and Theme/Dark.xaml, in the shapes of
     design/mockups/control-panel.html.

     Every key of the generated theme (B.*, R.*, S.*, T.*) is named with DynamicResource: the theme is swapped live, and
     a StaticResource is read once. StaticResource is only for keys this file holds itself. No colour and no font size
     is written here: XamlRulesTests fails one.

     There is no implicit TextBlock style on purpose: one in the application's resources reaches the text inside every
     control template and overrides the control's own Foreground. Text takes its font and colour from the window. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Bosun.Panel.Shell"
                    xmlns:a="clr-namespace:Bosun.Panel.Accessibility"
                    xmlns:theme="clr-namespace:Bosun.Panel.Theme"
                    xmlns:controls="clr-namespace:Bosun.Panel.Controls"
                    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <controls:StatusGlyph x:Key="StatusGlyph"/>
    <controls:PillCorners x:Key="PillCorners"/>

    <!-- Segoe UI Variable is the Windows 11 face; Segoe UI stands in where it is missing. -->
    <FontFamily x:Key="F.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas</FontFamily>

    <!-- Keyboard focus: a 2 px accent outline, 2 px outside the control. It is drawn in the adorner layer, so a
         neighbour never clips it. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderThickness="2" BorderBrush="{DynamicResource B.Accent}"
                            CornerRadius="{DynamicResource R.Control}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same outline drawn inside the control's bounds, for what sits against an edge that would clip a ring
         outside it: a row in a list, a table cell, a window button. -->
    <!-- Inside the control, for rows and segments that fill their own bounds. In a contrast theme the accent is the
         highlight, which also fills a selected rail row or segment: the ring would vanish exactly where it is needed,
         so a 1 px line in the window's colour runs inside it there (completion review of D02 T03 §4). -->
    <Style x:Key="FocusRing.Inside">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="ring" BorderThickness="2" BorderBrush="{DynamicResource B.Accent}"
                            CornerRadius="{DynamicResource R.Mark}" SnapsToDevicePixels="True">
                        <Border x:Name="inner" BorderThickness="1" BorderBrush="Transparent"
                                CornerRadius="{DynamicResource R.Mark}" SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="theme:HighContrastMode.IsOn" Value="True">
                            <Setter TargetName="inner" Property="BorderBrush" Value="{DynamicResource B.Base}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text -->
    <Style x:Key="T.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
    </Style>

    <Style x:Key="T.SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextMute}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- A section's heading, ranked above the field labels under it (D02 T04 §3): the body size, semibold, in the
         text colour, where a label is the caption size in the dim colour. A heading for a screen reader too. -->
    <Style x:Key="Section.Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Margin" Value="{DynamicResource Gap.Below.M}"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
    </Style>

    <!-- A card, as every page draws one (D02 T04 §3, lifted from the Memory page): the surface, a line, its corners,
         and the space scale's L all round inside it. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource R.Card}"/>
        <Setter Property="Padding" Value="{DynamicResource Inset.L}"/>
    </Style>

    <!-- A control's short explanation under it: the caption size in the dim colour, the scale's XS below the control. -->
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="{DynamicResource Gap.Above.XS}"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
        <!-- The gap to its control, from the space scale (D02 T04 §2). A label never sets its own Margin: that replaced
             this gap with 0 under the threshold's label. Space above it goes on what holds it. -->
        <Setter Property="Margin" Value="{DynamicResource Gap.Below.S}"/>
    </Style>

    <!-- Buttons: one template. The intents (primary, danger) and the small size are styles based on it, so each
         states its own colours and hover. A press washes the button with the text colour, whatever its intent. -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Body}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Background" Value="{DynamicResource B.Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="13,0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <!-- A disabled button can still say why, in its tooltip. -->
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource R.Control}"/>
                        <Border x:Name="wash" Background="{DynamicResource B.Text}" Opacity="0"
                                CornerRadius="{DynamicResource R.Control}"/>
                        <ContentPresenter x:Name="content" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="wash" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <!-- Disabled in its own colours at full strength (D02 T04 §6): faded to 0.4, a primary read as still active
                             and a secondary nearly vanished. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.DisabledFill}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.DisabledLine}"/>
                            <Setter TargetName="content" Property="TextElement.Foreground" Value="{DynamicResource B.DisabledText}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <!-- In a contrast theme (D02 T03 §10): Windows' colours, never a fade or the panel's own. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="root" Property="Opacity" Value="1"/>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.ButtonFace}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.GrayText}"/>
                            <Setter TargetName="content" Property="TextElement.Foreground" Value="{DynamicResource B.GrayText}"/>
                        </MultiTrigger>
                        <!-- Pressed in a contrast theme: the highlight pair, opaque, where the panel's own themes wash. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="wash" Property="Opacity" Value="0"/>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="content" Property="TextElement.Foreground" Value="{DynamicResource B.HighlightText}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.Hover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource B.LineStrong}"/>
            </Trigger>
            <!-- In a contrast theme (D02 T03 §10): the button colours the person chose in Windows, and under the
                 pointer the highlight pair, so hover still shows where the window colour is the button's own. -->
            <Trigger Property="theme:HighContrastMode.IsOn" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.ButtonFace}"/>
                <Setter Property="Foreground" Value="{DynamicResource B.ButtonText}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource B.ButtonText}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource B.Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource B.HighlightText}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- The same button for a tight row (a table's row action): smaller words, still a 32 px target. -->
    <Style x:Key="Btn.Small" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="FontSize" Value="{DynamicResource T.Caption}"/>
        <Setter Property="Padding" Value="8,0"/>
    </Style>

    <!-- Primary intent: the one action on a page that matters. -->
    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
        <Setter Property="Background" Value="{DynamicResource B.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.Accent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource B.Text}"/>
            </Trigger>
            <!-- In a contrast theme: the highlight pair, so the one action that matters still stands out. -->
            <Trigger Property="theme:HighContrastMode.IsOn" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource B.HighlightText}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Destructive intent: only for an action that stops something or changes the machine. -->
    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="{DynamicResource B.Danger}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Danger}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.DangerSoft}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource B.Danger}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Window buttons (minimise, maximise, close). Tag="danger" marks the close button. -->
    <Style x:Key="Btn.Chrome" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Inside}"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="Tag" Value="danger"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Danger}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Base}"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <!-- Disabled in its own text colour at full strength, its glyph following it (D02 T04 §6). -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource B.DisabledText}"/>
                        </Trigger>
                        <!-- In a contrast theme (D02 T03 §10): Windows' colours, never a fade or the panel's own. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.GrayText}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A status pill (D02 T03 §4, design/SPEC.md §19), as the mockup draws it: the state's glyph and word in its
         colour on a soft tint of it, fully round. Neutral is the dim text on the raised surface. In a contrast theme,
         an outline in the window's text: Windows' colours only. Seen, never focused (StatusPill). -->
    <Style TargetType="controls:StatusPill">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource B.Raised}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
        <!-- A 1 px edge in its status colour, Neutral in the line colour (D02 T04 §6): with none, the soft fill's edge
             read as a glow. -->
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StatusPill">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="8,3,9,3"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillCorners}}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Decorative VerticalAlignment="Center" Margin="0,0,5,0">
                                <icons:PackIconLucide Kind="{Binding Kind, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StatusGlyph}}"
                                                      Width="13" Height="13" Focusable="False" IsTabStop="False"
                                                      Foreground="{TemplateBinding Foreground}"/>
                            </controls:Decorative>
                            <TextBlock Text="{TemplateBinding ShownWord}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Kind" Value="Ok">
                <Setter Property="Background" Value="{DynamicResource B.OkSoft}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource B.OkLine}"/>
                <Setter Property="Foreground" Value="{DynamicResource B.Ok}"/>
            </Trigger>
            <Trigger Property="Kind" Value="Warn">
                <Setter Property="Background" Value="{DynamicResource B.WarnSoft}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource B.WarnLine}"/>
                <Setter Property="Foreground" Value="{DynamicResource B.Warn}"/>
            </Trigger>
            <Trigger Property="Kind" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource B.DangerSoft}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource B.DangerLine}"/>
                <Setter Property="Foreground" Value="{DynamicResource B.Danger}"/>
            </Trigger>
            <Trigger Property="Kind" Value="Info">
                <Setter Property="Background" Value="{DynamicResource B.InfoSoft}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource B.InfoLine}"/>
                <Setter Property="Foreground" Value="{DynamicResource B.Info}"/>
            </Trigger>
            <Trigger Property="theme:HighContrastMode.IsOn" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource B.Text}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A segment of a segmented control (D02 T03 §4): a 32 px target with the focus ring; dim until chosen, then the
         text colour in semibold, over the control's sliding indicator. In a contrast theme the chosen one is the
         highlight's text on the highlight, and a disabled one Windows' gray. -->
    <!-- A segment's ring, 2 px inside it: at the segment's own bounds it lay on the sliding thumb's edge and crowded
         the track (D02 T04 §1). The HighContrast inner line is kept, as FocusRing.Inside has it. -->
    <Style x:Key="FocusRing.Segment">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="ring" Margin="2" BorderThickness="2" BorderBrush="{DynamicResource B.Accent}"
                            CornerRadius="{DynamicResource R.Mark}" SnapsToDevicePixels="True">
                        <Border x:Name="inner" BorderThickness="1" BorderBrush="Transparent"
                                CornerRadius="{DynamicResource R.Mark}" SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="theme:HighContrastMode.IsOn" Value="True">
                            <Setter TargetName="inner" Property="BorderBrush" Value="{DynamicResource B.Base}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Segment" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Segment}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource R.Control}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource B.HighlightText}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.GrayText}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A segmented control (D02 T03 §4, design/SPEC.md §19), as the mockup draws it: its segments in a track of the
         hover colour with a line round it, the chosen one raised onto the surface by an indicator that slides between
         them (theme:RailMarker, horizontal). In a contrast theme the indicator is Windows' highlight. -->
    <Style TargetType="controls:SegmentedControl">
        <Setter Property="theme:RailMarker.Axis" Value="Horizontal"/>
        <Setter Property="theme:RailMarker.Slides" Value="True"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="{DynamicResource B.Hover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Segment}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SegmentedControl">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource R.Control}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <!-- The indicator behind the chosen segment, placed and slid by theme:RailMarker. Seen, never hit or said. -->
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="PART_Marker" Visibility="Collapsed" Background="{DynamicResource B.Surface}"
                                        BorderBrush="{DynamicResource B.Line}" BorderThickness="1" CornerRadius="{DynamicResource R.Control}"/>
                            </Canvas>
                            <ItemsPresenter/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="theme:HighContrastMode.IsOn" Value="True">
                            <Setter TargetName="PART_Marker" Property="Background" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="PART_Marker" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A rail row's count (D02 T03 §3, design/SPEC.md §19), as the mockup draws it: a small round pill in the
         warning tint, its figures semibold. Its text takes the pill's colour, in a contrast theme the window's own. -->
    <Style x:Key="CountBadge" TargetType="Border">
        <Setter Property="MinWidth" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource R.Pill}"/>
        <Setter Property="Background" Value="{DynamicResource B.WarnSoft}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource B.Warn}"/>
        <Setter Property="TextElement.FontSize" Value="{DynamicResource T.Caption}"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <!-- In a contrast theme, an outline in the row's own colour: the window's text, or on the selected row the
                 highlight's text, never white on the highlight's fill (completion review of D02 T03 §3). -->
            <Trigger Property="theme:HighContrastMode.IsOn" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="TextElement.Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A rail row (the NavList's): keyed, so a rail can add to it (the shell's rows say their count, D02 T03 §3). -->
    <Style x:Key="NavRow" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Inside}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="8,6"
                            CornerRadius="{DynamicResource R.Control}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Column 0 is where the list's one marker bar lands on the selected row (PART_Marker). -->
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Raised}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <!-- In a contrast theme (D02 T03 §10): Windows' colours, never a fade or the panel's own. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.HighlightText}"/>
                        </MultiTrigger>
                        <!-- In a contrast theme (D02 T03 §10): Windows' colours, never a fade or the panel's own. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.GrayText}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The rail. The style owns the row (hover, the selected row, the focus ring) and the one marker bar beside the
         selected row, which slides between rows (D02 T03 §3, theme:RailMarker). What a row shows (its title, glyph and
         count) is the row's own data template, shown through the ContentPresenter. -->
    <Style x:Key="NavList" TargetType="ListBox">
        <Setter Property="theme:RailMarker.Slides" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Inside}"/>
        <!-- Its own template: the stock list paints the system's control colour behind itself when it is disabled,
             a light box on a dark page. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                            <!-- A bar as well as a colour, so the selected page is told without hue: one bar for the
                                 whole list, over the rows, placed and slid by theme:RailMarker. Seen, never hit or said. -->
                            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                                <Border x:Name="PART_Marker" Width="3" Visibility="Collapsed" Background="{DynamicResource B.Accent}"
                                        CornerRadius="{DynamicResource R.Pill}"/>
                            </Canvas>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- In a contrast theme (D02 T03 §10) the selected row is filled with the highlight: the bar is its text colour. -->
                        <Trigger Property="theme:HighContrastMode.IsOn" Value="True">
                            <Setter TargetName="PART_Marker" Property="Background" Value="{DynamicResource B.HighlightText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavRow}"/>
    </Style>

    <!-- The activity log. A line is read, not acted on: the list takes the keyboard (to scroll), its lines do not.
         What a line shows is the entry's own data template. -->
    <Style x:Key="LogBox" TargetType="ListBox">
        <!-- The stock list sets the system's text colour, which its lines would inherit. -->
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Inside}"/>
        <!-- Its own template: the stock list paints the system's control colour behind itself when it is disabled,
             a light box on a dark page. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Padding" Value="16,2"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A line of the activity log (D02 T02 §4, design/SPEC.md §1): the word first, then the time and the message.
         The word says the state; its colour only repeats it. Found by the line's type, wherever one is shown. -->
    <DataTemplate DataType="{x:Type shell:LogEntry}">
        <DockPanel>
            <TextBlock x:Name="word" DockPanel.Dock="Left" Text="{Binding Tag}" Style="{StaticResource T.Mono}"
                       FontWeight="Bold" Width="44"/>
            <TextBlock x:Name="time" DockPanel.Dock="Left" Text="{Binding Time}" Style="{StaticResource T.Mono}"
                       Foreground="{DynamicResource B.TextMute}" Width="72"/>
            <TextBlock x:Name="message" Text="{Binding Message}" Style="{StaticResource T.Mono}"
                       Foreground="{DynamicResource B.Text}" TextWrapping="Wrap"/>
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Warn">
                <Setter TargetName="word" Property="Foreground" Value="{DynamicResource B.Warn}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Fail">
                <Setter TargetName="word" Property="Foreground" Value="{DynamicResource B.Danger}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Scroll bars. The stock one is light chrome with stepper buttons, the loudest thing on a dark page. Its thumb
         and the track either side are named, so a screen reader can say what each is (D03 T02 §2: the smoke found
         them unnamed once a page first scrolled). -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- Transparent around the thumb, so the whole 10 px is the grip. -->
                    <Border Background="Transparent">
                        <Border x:Name="th" Margin="2" Background="{DynamicResource B.Line}"
                                CornerRadius="{DynamicResource R.Pill}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="th" Property="Background" Value="{DynamicResource B.TextMute}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="th" Property="Background" Value="{DynamicResource B.TextMute}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The track either side of the thumb: a click pages, and nothing is drawn. -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A page's scroll area whose bar keeps its own gutter (D02 T04 §8): the content, a gap from the space scale, then
         the bar, the gap there only while the bar shows, so a card's border never meets the bar and a page that fits
         keeps its full width. WPF's own template sets the bar straight against the content. -->
    <Style x:Key="Scroll.Gutter" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <Border x:Name="Gutter" Grid.Column="1" Width="{DynamicResource S.S}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="2" Orientation="Vertical"
                                   Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   AutomationProperties.Name="Scroll the page"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Collapsed">
                            <Setter TargetName="Gutter" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Hidden">
                            <Setter TargetName="Gutter" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" AutomationProperties.Name="Scroll position"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" AutomationProperties.Name="Page down"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" AutomationProperties.Name="Page up"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- A horizontal bar is as wide as its space and 10 px high: the width above is the vertical bar's. -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" AutomationProperties.Name="Scroll position"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" AutomationProperties.Name="Page right"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" AutomationProperties.Name="Page left"/>
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- One tab in the strip; a tab that needs a condition is based on it. -->
    <!-- The header's font and colour are set on the header, not on the tab: a tab's content is the tab's child, and
         would inherit them (a page drawn semi-bold in the accent). The tab's own Foreground is the page's text
         colour, for that content: the stock tab sets the system's, which is black on a dark page. -->
    <Style x:Key="TabStrip.Item" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Inside}"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="0,0,0,2" Padding="14,12" Margin="0,0,4,0">
                        <ContentPresenter x:Name="header" ContentSource="Header" VerticalAlignment="Center"
                                          TextElement.FontFamily="{StaticResource F.Ui}"
                                          TextElement.FontSize="{DynamicResource T.Body}"
                                          TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{DynamicResource B.TextDim}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="header" Property="TextElement.Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="header" Property="TextElement.Foreground" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                        <!-- Focus is the inside ring alone (FocusVisualStyle): no hover fill beside it (D02 T04 §1). -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <!-- In a contrast theme (D02 T03 §10): Windows' colours, never a fade or the panel's own. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Opacity" Value="1"/>
                            <Setter TargetName="header" Property="TextElement.Foreground" Value="{DynamicResource B.GrayText}"/>
                        </MultiTrigger>
                        <!-- Selected in a contrast theme: highlight text on the highlight, never the highlight as text. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.HighlightText}"/>
                            <Setter TargetName="header" Property="TextElement.Foreground" Value="{DynamicResource B.HighlightText}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab strip: text tabs over a 1 px rule, the selected one in the accent with a 2 px underline, the rail's own
         signal. Left and Right move between tabs, which TabControl gives. Tag is the strip's trailing slot, for a
         caption beside the tabs. -->
    <Style x:Key="TabStrip" TargetType="TabControl">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Inside}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{DynamicResource B.Line}" BorderThickness="0,0,0,1"
                                Margin="0,0,0,16">
                            <DockPanel>
                                <TabPanel x:Name="HeaderPanel" DockPanel.Dock="Left" IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1" Margin="0,0,0,-1"/>
                                <!-- What the strip says beside its tabs ("3 waiting"): a count pill on the tabs' text line, not
                                     loose text above it (D02 T04 §6). Shown only when there is something to say. -->
                                <Border x:Name="TrailingPill" Background="{DynamicResource B.Raised}" BorderBrush="{DynamicResource B.Line}"
                                        BorderThickness="1" Padding="8,3,8,3"
                                        CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillCorners}}"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" Margin="{DynamicResource Gap.Before.S}">
                                    <ContentPresenter x:Name="Trailing" Content="{TemplateBinding Tag}" VerticalAlignment="Center"
                                                      TextElement.FontSize="{DynamicResource T.Caption}"
                                                      TextElement.Foreground="{DynamicResource B.TextDim}"/>
                                </Border>
                            </DockPanel>
                        </Border>
                        <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="TrailingPill" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle" Value="{StaticResource TabStrip.Item}"/>
    </Style>

    <!-- A form field: a raised well whose border turns to the accent while the keyboard is in it. -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Background" Value="{DynamicResource B.Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource B.Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource B.AccentDim}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Body}"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource R.Control}">
                        <!-- No margin of its own: a TextBox applies its Padding to its text host itself, so a margin
                             of the same Padding here put the text twice as far in as a combo box's (D02 T04 §2). -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
                    </Border>
                    <!-- Focus is the ring alone (FocusVisualStyle, 2 px outside): a border that also turned accent
                         drew a second outline (D02 T04 §1). -->
                    <ControlTemplate.Triggers>
                        <!-- An error shows on the field itself (D02 T04 §2), set from the page's own validation. -->
                        <!-- Two cues, so an error never rests on colour alone: a contrast theme draws every border in
                             one system colour, where only the thicker line tells it (completion review). -->
                        <Trigger Property="theme:FieldState.Invalid" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.Danger}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
                        </Trigger>
                        <!-- In a contrast theme (D02 T03 §10): Windows' colours, never a fade or the panel's own. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Opacity" Value="1"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.GrayText}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.GrayText}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- In a contrast theme (D02 T03 §10): selected text is the highlight text on the highlight, at full strength. -->
            <Trigger Property="theme:HighContrastMode.IsOn" Value="True">
                <Setter Property="SelectionBrush" Value="{DynamicResource B.Accent}"/>
                <Setter Property="SelectionTextBrush" Value="{DynamicResource B.HighlightText}"/>
                <Setter Property="SelectionOpacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Check box. The whole row, box and words, is the target. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Body}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="row" Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="box" Width="16" Height="16" BorderThickness="1"
                                    CornerRadius="{DynamicResource R.Mark}"
                                    BorderBrush="{DynamicResource B.TextMute}" Background="{DynamicResource B.Raised}"
                                    VerticalAlignment="Center">
                                <Path x:Name="tick" Data="M2,7 L5.5,10.5 L12,3.5" StrokeThickness="2"
                                      Stroke="{DynamicResource B.OnAccent}" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter x:Name="words" Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                        <!-- Focus is the ring alone (FocusVisualStyle): the box no longer turns accent for it too (D02 T04 §1). -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="row" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <!-- In a contrast theme (D02 T03 §10): Windows' colours, never a fade or the panel's own. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="row" Property="Opacity" Value="1"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource B.GrayText}"/>
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource B.Base}"/>
                            <Setter TargetName="tick" Property="Stroke" Value="{DynamicResource B.GrayText}"/>
                            <Setter TargetName="words" Property="TextElement.Foreground" Value="{DynamicResource B.GrayText}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Body}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Inside}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="4,1"
                            CornerRadius="{DynamicResource R.Mark}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.AccentDim}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <!-- In a contrast theme (D02 T03 §10): Windows' colours, never a fade or the panel's own. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsHighlighted" Value="True"/>
                                <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.HighlightText}"/>
                        </MultiTrigger>
                        <!-- In a contrast theme (D02 T03 §10): Windows' colours, never a fade or the panel's own. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.HighlightText}"/>
                        </MultiTrigger>
                        <!-- In a contrast theme (D02 T03 §10): Windows' colours, never a fade or the panel's own. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.GrayText}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Combo box. Brush setters alone do nothing here: the stock chrome comes from the stock template, which ignores
         them. Tag holds the words shown while nothing is selected. -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Body}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="root">
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{DynamicResource B.Raised}"
                                            BorderBrush="{DynamicResource B.Line}" BorderThickness="1"
                                            CornerRadius="{DynamicResource R.Control}">
                                        <Path x:Name="arrow" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource B.TextDim}"
                                              StrokeThickness="1.4" Margin="0,0,10,0" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                                            <Setter TargetName="bd" Property="BorderBrush"
                                                    Value="{DynamicResource B.LineStrong}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                                        </Trigger>
                                        <!-- A disabled box in a contrast theme (D02 T03 §10): its edge and arrow in gray text. -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsEnabled" Value="False"/>
                                                <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.GrayText}"/>
                                            <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource B.GrayText}"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="Selected" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="11,0,30,0" VerticalAlignment="Center"/>

                        <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Visibility="Collapsed"
                                   Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{DynamicResource B.TextMute}" Margin="11,0,30,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                        <!-- No PopupAnimation: WPF's fade is a fixed 150 ms that ignores the Windows animation
                             setting, and motion here has one gate (Theme/Motion.cs, D02 T03 §1). The list opens
                             at once. -->
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                            <Border x:Name="Drop" Background="{DynamicResource B.Raised}"
                                    BorderBrush="{DynamicResource B.Line}" BorderThickness="1"
                                    CornerRadius="{DynamicResource R.Control}"
                                    MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,0" Padding="0,4">
                                <ScrollViewer x:Name="DropScroll" MaxHeight="260">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedIndex" Value="-1">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                        <!-- In a contrast theme (D02 T03 §10): Windows' colours, never a fade or the panel's own. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="root" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.GrayText}"/>
                            <Setter TargetName="Selected" Property="TextElement.Foreground" Value="{DynamicResource B.GrayText}"/>
                            <Setter TargetName="Placeholder" Property="Foreground" Value="{DynamicResource B.GrayText}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tooltips: the stock one is a light box on a dark window. -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Background" Value="{DynamicResource B.Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Caption}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource R.Control}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tables. Read-only rows a person selects whole; a page that edits in place says so on its own grid. -->
    <Style x:Key="Cell.Text" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Numbers line up: right-aligned, every digit the same width. -->
    <Style x:Key="Cell.Number" TargetType="TextBlock" BasedOn="{StaticResource Cell.Text}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Style.Triggers>
            <!-- A word where a number goes ("Not available"): dim, its reason its tooltip (D02 T04 §4). -->
            <Trigger Property="controls:TableColumn.IsWord" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
            </Trigger>
            <!-- Selected in a contrast theme the row is the highlight: the word takes the highlight's own text colour. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding (controls:TableColumn.IsWord), RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding (theme:HighContrastMode.IsOn), RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource B.HighlightText}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding (controls:TableColumn.IsWord), RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding (theme:HighContrastMode.IsOn), RelativeSource={RelativeSource Self}}" Value="True"/>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource B.HighlightText}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The edge of a column header: dragging it resizes the column. Nothing is drawn. -->
    <!-- Named for a screen reader by the column it resizes ("Resize Peak GB"): the first real page with a table, the
         Memory page (D03 T01 §2), left these unnamed, and the end-to-end smoke's every-control-named check found them. -->
    <Style x:Key="ColumnGripper" TargetType="Thumb">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="AutomationProperties.Name"
                Value="{Binding Content, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, StringFormat=Resize {0}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource B.TextMute}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <!-- XS before the text, clear of an inside focus ring, and M after it to the next column; the table bleeds the
             XS into its card, so its text starts at the card's edge (D02 T04 §4). -->
        <Setter Property="Padding" Value="{DynamicResource Cell.Pad}"/>
        <Setter Property="controls:TableColumn.Watch" Value="True"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Inside}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <!-- A number column's arrow sits before its right-aligned text, so the text ends where its
                                     numbers do whichever way it is sorted (D02 T04 §4). -->
                                <Path x:Name="sortBefore" Data="M0,4 L4,0 L8,4" Stroke="{DynamicResource B.TextMute}"
                                      StrokeThickness="1.4" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <ContentPresenter RecognizesAccessKey="False"/>
                                <!-- The sort is shown by an arrow, not by colour. -->
                                <Path x:Name="sort" Data="M0,4 L4,0 L8,4" Stroke="{DynamicResource B.TextMute}"
                                      StrokeThickness="1.4" Margin="6,0,0,0" VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                               Style="{StaticResource ColumnGripper}"/>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                               Style="{StaticResource ColumnGripper}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="sort" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="sort" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="sort" Property="Data" Value="M0,0 L4,4 L8,0"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="controls:TableColumn.IsNumberHeader" Value="True"/>
                                <Condition Property="SortDirection" Value="Ascending"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="sort" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="sortBefore" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="controls:TableColumn.IsNumberHeader" Value="True"/>
                                <Condition Property="SortDirection" Value="Descending"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="sort" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="sortBefore" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="sortBefore" Property="Data" Value="M0,0 L4,4 L8,0"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="controls:TableColumn.IsNumberHeader" Value="True">
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Inside}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.AccentDim}"/>
            </Trigger>
            <!-- In a contrast theme (D02 T03 §10): Windows' colours, never a fade or the panel's own. -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource B.Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource B.HighlightText}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- The row shows the selection, so a cell draws nothing of its own but its focus ring. -->
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="{DynamicResource Cell.Pad}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Inside}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- In a contrast theme (D02 T03 §10): Windows' colours, never a fade or the panel's own. -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource B.HighlightText}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <!-- Its cells' XS before the text bled into what holds it: the text starts at the card's edge (D02 T04 §4). -->
        <Setter Property="Margin" Value="{DynamicResource Bleed.Before.XS}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Body}"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
    </Style>

    <!-- A value that could not be read (D02 T03 §7, design/SPEC.md §1): "Not available" with why, never 0 or nothing.
         A page gives a NotAvailable where it would give the value; this template draws it wherever it is shown. -->
    <DataTemplate DataType="{x:Type shell:NotAvailable}">
        <StackPanel>
            <TextBlock Text="Not available" Foreground="{DynamicResource B.TextDim}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource B.TextMute}" FontSize="{DynamicResource T.Caption}"
                       TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
    </DataTemplate>

    <!-- A ContentControl holding a value: a value draws through its own template, a NotAvailable through the one above,
         and a null, which can't say why, as "Not available" with "It could not be read." rather than as nothing. -->
    <Style x:Key="Value" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Style.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <StackPanel>
                                <TextBlock Text="Not available" Foreground="{DynamicResource B.TextDim}" FontWeight="SemiBold"/>
                                <TextBlock Text="It could not be read." Foreground="{DynamicResource B.TextMute}"
                                           FontSize="{DynamicResource T.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A radial gauge (D02 T03 §5): the arc of a value over its total in the state's colour (the accent when it has
         none) on the empty track, the number large in the centre, the unit dim under it and the state word in the
         state's colour. With no readable value: the empty track and "Not available". In a contrast theme the arc is the
         highlight, the track Windows' gray and the word the text colour. -->
    <Style TargetType="controls:RadialGauge">
        <Setter Property="Width" Value="128"/>
        <Setter Property="Height" Value="128"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:RadialGauge">
                    <Grid>
                        <controls:GaugeArc x:Name="arc" Target="{TemplateBinding Fraction}" Thickness="10"
                                           Track="{DynamicResource B.Hover}" Fill="{TemplateBinding Foreground}"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,6,14,0">
                            <TextBlock x:Name="number" Text="{TemplateBinding ShownNumber}" HorizontalAlignment="Center" TextAlignment="Center"
                                       FontFamily="{StaticResource F.Display}" FontSize="{DynamicResource T.Metric}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B.Text}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="unit" Text="{TemplateBinding ShownUnit}" HorizontalAlignment="Center"
                                       FontSize="{DynamicResource T.Caption}" Foreground="{DynamicResource B.TextDim}"/>
                            <TextBlock x:Name="word" Text="{TemplateBinding ShownWord}" HorizontalAlignment="Center" Margin="0,2,0,0"
                                       FontSize="{DynamicResource T.Caption}" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Fraction" Value="{x:Null}">
                            <Setter TargetName="number" Property="FontSize" Value="{DynamicResource T.Body}"/>
                            <Setter TargetName="number" Property="FontWeight" Value="Normal"/>
                            <Setter TargetName="number" Property="Foreground" Value="{DynamicResource B.TextDim}"/>
                            <Setter TargetName="unit" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="word" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="theme:HighContrastMode.IsOn" Value="True">
                            <Setter TargetName="arc" Property="Track" Value="{DynamicResource B.GrayText}"/>
                            <Setter TargetName="arc" Property="Fill" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="word" Property="Foreground" Value="{DynamicResource B.Text}"/>
                            <Setter TargetName="unit" Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="State" Value="Ok">
                <Setter Property="Foreground" Value="{DynamicResource B.Ok}"/>
            </Trigger>
            <Trigger Property="State" Value="Warn">
                <Setter Property="Foreground" Value="{DynamicResource B.Warn}"/>
            </Trigger>
            <Trigger Property="State" Value="Danger">
                <Setter Property="Foreground" Value="{DynamicResource B.Danger}"/>
            </Trigger>
            <Trigger Property="State" Value="Info">
                <Setter Property="Foreground" Value="{DynamicResource B.Info}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A stacked bar (D02 T03 §5): the bar, then the legend under it, each line its swatch, name and value in words.
         With no readable shares: the empty track and "Not available". In a contrast theme the empty track is Windows'
         gray and the legend the text colour. -->
    <Style TargetType="controls:StackedBar">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StackedBar">
                    <StackPanel>
                        <controls:BarTrack x:Name="bar" Values="{TemplateBinding Shown}" Track="{DynamicResource B.Hover}" Margin="0,6,0,8"/>
                        <ItemsControl x:Name="legend" ItemsSource="{TemplateBinding Legend}" Focusable="False" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="controls:LegendLine">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,2">
                                        <controls:Swatch Role="{Binding Role}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="none" Text="Not available" Visibility="Collapsed"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Available" Value="False">
                            <Setter TargetName="legend" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="none" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="theme:HighContrastMode.IsOn" Value="True">
                            <Setter TargetName="bar" Property="Track" Value="{DynamicResource B.GrayText}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A queue slot's tile (D02 T03 §6, the mockup's .slot): its glyph, number and state word on top, the holder's job,
         side and times under them, "may have ended" in the warning colour when its process couldn't be checked, and the
         moving bar along the bottom while held. Held: the accent's border on its soft fill. Free: a dashed outline and
         the muted text. In a contrast theme: Windows' text for every line and outline, the highlight for a held one. -->
    <Style TargetType="controls:QueueSlotTile">
        <Setter Property="MinWidth" Value="240"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Background" Value="{DynamicResource B.Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:QueueSlotTile">
                    <Grid>
                        <Border x:Name="tile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource R.Control}" ClipToBounds="True">
                            <Grid>
                                <StackPanel Margin="14,12,14,12">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Decorative VerticalAlignment="Center" Margin="0,0,7,0">
                                            <icons:PackIconLucide Kind="{TemplateBinding Glyph}" Width="14" Height="14" Focusable="False" IsTabStop="False"
                                                                  Foreground="{TemplateBinding Foreground}"/>
                                        </controls:Decorative>
                                        <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- The state's word on its own line, so a long one never squeezes the slot's number. -->
                                    <controls:StatusPill Kind="{TemplateBinding Kind}" Word="{TemplateBinding Word}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                    <!-- The whole job, wrapped, never cut: two commands can differ only in their last arguments. -->
                                    <TextBlock x:Name="job" Text="{TemplateBinding Job}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="timing" Text="{TemplateBinding Timing}" FontSize="{DynamicResource T.Caption}"
                                               Foreground="{DynamicResource B.TextDim}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="doubt" Text="{TemplateBinding Doubt}" FontSize="{DynamicResource T.Caption}"
                                               Foreground="{DynamicResource B.Warn}"/>
                                </StackPanel>
                                <controls:SlotBar x:Name="bar" VerticalAlignment="Bottom" Active="{TemplateBinding Held}" Fill="{DynamicResource B.Accent}"/>
                            </Grid>
                        </Border>
                        <Rectangle x:Name="dash" Visibility="Collapsed" Stroke="{DynamicResource B.Line}" StrokeThickness="1"
                                   StrokeDashArray="4 3" RadiusX="8" RadiusY="8" SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Job" Value="">
                            <Setter TargetName="job" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Timing" Value="">
                            <Setter TargetName="timing" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Doubt" Value="">
                            <Setter TargetName="doubt" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="State" Value="Free">
                            <Setter TargetName="tile" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="tile" Property="Background" Value="Transparent"/>
                            <Setter TargetName="dash" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="theme:HighContrastMode.IsOn" Value="True">
                            <Setter TargetName="timing" Property="Foreground" Value="{DynamicResource B.Text}"/>
                            <Setter TargetName="doubt" Property="Foreground" Value="{DynamicResource B.Text}"/>
                            <Setter TargetName="dash" Property="Stroke" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Held" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.AccentDim}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
            </Trigger>
            <Trigger Property="State" Value="Free">
                <Setter Property="Foreground" Value="{DynamicResource B.TextMute}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                    <Condition Property="Held" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource B.Text}"/>
                <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                    <Condition Property="Held" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- The waiting jobs (D02 T03 §6): a line each, in order, and under them what can't be shown or "Nothing waiting". -->
    <Style TargetType="controls:WaitingRow">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:WaitingRow">
                    <StackPanel>
                        <ItemsControl ItemsSource="{TemplateBinding Lines}" Focusable="False" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="controls:WaitingLine">
                                    <controls:WaitingLineView Content="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="notice" Text="{TemplateBinding Notice}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource B.TextDim}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Notice" Value="">
                            <Setter TargetName="notice" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="theme:HighContrastMode.IsOn" Value="True">
                            <Setter TargetName="notice" Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One waiting job: its place, then its repo and command, why it waits and its side and waited time. -->
    <Style TargetType="controls:WaitingLineView">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:WaitingLineView">
                    <Border x:Name="line" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource B.Line}" Padding="0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="place" Text="{Binding Place}" FontFamily="{StaticResource F.Mono}" Foreground="{DynamicResource B.TextDim}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="job" Text="{Binding Job}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Why}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="meta" Text="{Binding Meta}" FontSize="{DynamicResource T.Caption}" Foreground="{DynamicResource B.TextDim}"/>
                                <TextBlock x:Name="doubt" Text="May have ended" FontSize="{DynamicResource T.Caption}" Foreground="{DynamicResource B.Warn}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Doubtful}" Value="True">
                            <Setter TargetName="doubt" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <Trigger Property="theme:HighContrastMode.IsOn" Value="True">
                            <Setter TargetName="place" Property="Foreground" Value="{DynamicResource B.Text}"/>
                            <Setter TargetName="meta" Property="Foreground" Value="{DynamicResource B.Text}"/>
                            <Setter TargetName="doubt" Property="Foreground" Value="{DynamicResource B.Text}"/>
                            <Setter TargetName="line" Property="BorderBrush" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The command palette (D02 T03 §8): its search field, a field a little taller; its list, which never takes the
         keyboard (the search field keeps it); and its rows: glyph, name and group, and the reason under a row that can't
         run. The selected row is the hover colour; a danger row's name the danger colour. In a contrast theme the
         selected row is the highlight with its text, and every other line Windows' text. -->
    <!-- The palette's search: one field with its glyph inside it, no border of its own inside the palette's card (D02
         T04 §7: a bordered box sat in the bordered card with the glyph outside it). Its focus is the field's one ring. -->
    <Style x:Key="PaletteSearch" TargetType="TextBox" BasedOn="{StaticResource Field}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Subtitle}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource R.Control}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:Decorative VerticalAlignment="Center" Margin="{DynamicResource Gap.Before.S}">
                                <icons:PackIconLucide x:Name="SearchGlyph" Kind="{x:Static theme:Glyphs.Search}" Width="16" Height="16"
                                                      Focusable="False" IsTabStop="False" Foreground="{DynamicResource B.TextDim}"/>
                            </controls:Decorative>
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PaletteList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="0">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PaletteRow" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing.Inside}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}"/>
        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding Reason}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource R.Control}" Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <controls:Decorative VerticalAlignment="Top" Margin="0,2,10,0">
                                <icons:PackIconLucide x:Name="glyph" Kind="{Binding Glyph}" Width="15" Height="15" Focusable="False" IsTabStop="False"
                                                      Foreground="{DynamicResource B.TextDim}"/>
                            </controls:Decorative>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="name" Text="{Binding Name}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="reason" Text="{Binding Reason}" FontSize="{DynamicResource T.Caption}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource B.TextDim}" Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock x:Name="group" Grid.Column="2" Text="{Binding Group}" Margin="12,1,0,0" VerticalAlignment="Top"
                                       FontSize="{DynamicResource T.Caption}" Foreground="{DynamicResource B.TextMute}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                            <Setter TargetName="reason" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="name" Property="Foreground" Value="{DynamicResource B.TextDim}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Danger}" Value="True">
                            <Setter TargetName="name" Property="Foreground" Value="{DynamicResource B.Danger}"/>
                            <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource B.Danger}"/>
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                        </Trigger>
                        <Trigger Property="theme:HighContrastMode.IsOn" Value="True">
                            <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource B.Text}"/>
                            <Setter TargetName="reason" Property="Foreground" Value="{DynamicResource B.Text}"/>
                            <Setter TargetName="group" Property="Foreground" Value="{DynamicResource B.Text}"/>
                            <Setter TargetName="name" Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="theme:HighContrastMode.IsOn" Value="True"/>
                                <Condition Property="IsSelected" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                            <Setter TargetName="reason" Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                            <Setter TargetName="group" Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                            <Setter TargetName="name" Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A toast's card (D02 T03 §9, design/SPEC.md §19 Toast): its state pill and Dismiss on the first line, so Dismiss is
         always reachable, then its words at most three lines, the whole result in its tooltip and help text. The words are
         a live region, announced once. Raised on the overlay's shadow; in a contrast theme the window's colours, outlined. -->
    <Style TargetType="shell:ToastCard">
        <Setter Property="Width" Value="360"/>
        <Setter Property="Background" Value="{DynamicResource B.Raised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.LineStrong}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource T.Body}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shell:ToastCard">
                    <Border x:Name="card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource R.Control}" Padding="12,8,8,12" Effect="{DynamicResource Elevation.Overlay}">
                        <StackPanel>
                            <DockPanel>
                                <!-- Show more then Dismiss, in reading order for the eye and the Tab key alike (D02 T04 §7). -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="ShowMore" Style="{StaticResource Btn.Small}" Margin="0,0,6,0" MinHeight="32"
                                            Content="Show more" Command="{Binding ShowMore, RelativeSource={RelativeSource TemplatedParent}}"
                                            AutomationProperties.Name="Show the whole message" Visibility="Collapsed"/>
                                    <Button x:Name="Dismiss" Style="{StaticResource Btn.Small}" Content="Dismiss"
                                            Command="{Binding Dismiss, RelativeSource={RelativeSource TemplatedParent}}"
                                            AutomationProperties.Name="Dismiss" AutomationProperties.HelpText="{Binding Spoken}"/>
                                </StackPanel>
                                <controls:StatusPill Kind="{Binding Kind}" Word="{Binding Word}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </DockPanel>
                            <!-- Its first three lines; expanded, the whole message in a scroll bounded by Size.ToastText, so
                                 three expanded toasts still fit the smallest window with every Dismiss on screen (D02 T04 §7). -->
                            <shell:ToastMessage x:Name="WordsScroll" Margin="2,8,4,0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                                Focusable="False" IsTabStop="False" AutomationProperties.HelpText="{Binding Message}">
                                <TextBlock x:Name="Words" Text="{Binding Message}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           LineHeight="19" LineStackingStrategy="BlockLineHeight" MaxHeight="57"
                                           ToolTip="{Binding Message}" AutomationProperties.HelpText="{Binding Message}"
                                           AutomationProperties.Name="{Binding Spoken}" a:LiveRegion.Announce="True"/>
                            </shell:ToastMessage>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCut" Value="True">
                            <Setter TargetName="ShowMore" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Expanded}" Value="True">
                            <Setter TargetName="Words" Property="MaxHeight" Value="Infinity"/>
                            <Setter TargetName="Words" Property="TextTrimming" Value="None"/>
                            <Setter TargetName="WordsScroll" Property="MaxHeight" Value="{DynamicResource Size.ToastText}"/>
                            <Setter TargetName="WordsScroll" Property="VerticalScrollBarVisibility" Value="Auto"/>
                            <Setter TargetName="WordsScroll" Property="Focusable" Value="True"/>
                            <Setter TargetName="WordsScroll" Property="IsTabStop" Value="True"/>
                            <Setter TargetName="WordsScroll" Property="AutomationProperties.Name" Value="The whole message"/>
                            <Setter TargetName="ShowMore" Property="Content" Value="Show less"/>
                            <Setter TargetName="ShowMore" Property="AutomationProperties.Name" Value="Show the first lines again"/>
                        </DataTrigger>
                        <Trigger Property="theme:HighContrastMode.IsOn" Value="True">
                            <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
