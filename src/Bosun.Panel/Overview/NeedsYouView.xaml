<!-- The Needs you table (D03 T01 §5, design/SPEC.md §2): state word, what, where and Open, in Needs you's order, or
     "Nothing needs you." once every provider has looked. Its DataContext is the page's NeedsYouTable: the Overview
     draws it under its cards, and the page frame keeps it above the failure when every card fails (PageFrame.xaml). -->
<UserControl x:Class="Bosun.Panel.Overview.NeedsYouView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:controls="clr-namespace:Bosun.Panel.Controls"
             xmlns:theme="clr-namespace:Bosun.Panel.Theme"
             Focusable="False">
    <Border Style="{DynamicResource Card}" AutomationProperties.Name="Needs you">
        <StackPanel>
            <TextBlock x:Name="NeedsHeading" Text="Needs you" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
            <TextBlock x:Name="NeedsEmpty" Text="{Binding Empty}" Foreground="{DynamicResource B.TextDim}" TextWrapping="Wrap"
                       Margin="{DynamicResource Gap.Above.S}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Empty}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- Collapsed while it has no rows, on a holder of its own: the table keeps the theme's own DataGrid style. -->
            <Border x:Name="NeedsTableHolder">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Lines.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DataGrid x:Name="NeedsTable" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserSortColumns="False" SelectionMode="Single" AutomationProperties.Name="Needs you"
                          Margin="{DynamicResource Gap.Above.S}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="State" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusPill Kind="{Binding Kind}" Word="{Binding State}" VerticalAlignment="Center" Margin="{DynamicResource Inset.XS}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="What" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="What" Text="{Binding What}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="{DynamicResource Inset.XS}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <controls:TextColumn Header="Where" Binding="{Binding Where}" Width="Auto"/>
                        <DataGridTemplateColumn Header="Open" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- A 32 px target named for its row (design/SPEC.md §1), going to the row's page. -->
                                    <Button x:Name="OpenRow" Style="{DynamicResource Btn.Small}" MinHeight="32" Command="{Binding Open}"
                                            AutomationProperties.Name="{Binding OpenName}" ToolTip="{Binding Where, StringFormat='Open the {0} page'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Open" VerticalAlignment="Center"/>
                                            <controls:Decorative Margin="{DynamicResource Gap.Before.XS}" VerticalAlignment="Center">
                                                <icons:PackIconLucide Kind="{x:Static theme:Glyphs.GoToPage}" Width="12" Height="12" Focusable="False"/>
                                            </controls:Decorative>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
