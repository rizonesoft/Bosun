<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <!-- The core's documents, captured and written to its writers' rules (D03 T01 §1), beside the test binary. -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bosun.Core\Bosun.Core.csproj" />
    <!-- Built first, never referenced: the process runner's tests start it as a program. -->
    <ProjectReference Include="..\Bosun.TestChild\Bosun.TestChild.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
