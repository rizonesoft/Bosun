* text=auto

# Read by bash in WSL or by Git's own shell: a CR breaks them, whatever the clone's autocrlf says.
*.sh text eol=lf
*.py text eol=lf
wsl/bosun text eol=lf
scripts/hooks/* text eol=lf
# Compared byte for byte with the generated plan (D00 T07 §1), so no checkout may turn its LF into CRLF.
scripts/tests/fixtures/plan-baseline.md -text

*.png binary
*.ico binary
