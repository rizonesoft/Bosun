#!/bin/bash
# WSL front end for bosun. Windows and WSL jobs share the same slots.
# Holding a slot means keeping a bosun.exe acquire process alive on a pipe.
# When this script ends for any reason the pipe closes and the slot frees.
set -u

die() { echo "[bosun] $*" >&2; exit 64; }

# The installed file supplies defaults; an explicit BOSUN_EXE still wins.
explicit_exe="${BOSUN_EXE:-}"
[ -r "$HOME/.config/bosun/env" ] && . "$HOME/.config/bosun/env"
EXE="${explicit_exe:-${BOSUN_EXE:-bosun.exe}}"
export BOSUN_EXE="$EXE"  # A nested shim must use the same executable.
MIN_GUEST_MB="${BOSUN_MIN_GUEST_MB:-3072}"
MAX_WAIT="${BOSUN_MAX_WAIT:-900}"
MAX_WRITE_GB="${BOSUN_MAX_WRITE_GB:-100}"

guest_avail_mb() { awk '/^MemAvailable:/ {print int($2/1024)}' /proc/meminfo; }

if [ "${1:-}" = "status" ] && [ -n "${BOSUN_SLOTS:-}" ]; then
  shift
  exec "$EXE" status --slots "$BOSUN_SLOTS" "$@"  # Later flags win, so a typed --slots still applies.
fi
[ "${1:-}" = "run" ] || exec "$EXE" "$@"
shift

# Linux variables do not reach bosun.exe by themselves, so they travel as flags.
# Flags from the command line come later and win.
args=(--max-wait "$MAX_WAIT")
[ -n "${BOSUN_SLOTS:-}" ] && args+=(--slots "$BOSUN_SLOTS")
[ -n "${BOSUN_MIN_AVAIL_MB:-}" ] && args+=(--min-avail-mb "$BOSUN_MIN_AVAIL_MB")
while [ $# -gt 0 ] && [ "$1" != "--" ]; do
  case "$1" in
    --max-wait) [ $# -ge 2 ] || die "--max-wait needs a value"; MAX_WAIT="$2"; args+=("$1" "$2"); shift 2 ;;
    --min-guest-mb) [ $# -ge 2 ] || die "--min-guest-mb needs a value"; MIN_GUEST_MB="$2"; shift 2 ;;
    --max-write-gb) [ $# -ge 2 ] || die "--max-write-gb needs a value"; MAX_WRITE_GB="$2"; shift 2 ;;
    --slots|--min-avail-mb|--ns) [ $# -ge 2 ] || die "$1 needs a value"; args+=("$1" "$2"); shift 2 ;;
    *) die "unknown option $1" ;;
  esac
done
[ "${1:-}" = "--" ] || die "usage: bosun run [options] -- command [args]"
shift
[ $# -gt 0 ] || die "usage: bosun run [options] -- command [args]"

# Already inside a slot, so a script calling itself cannot deadlock.
[ -n "${BOSUN_SLOT:-}" ] && exec "$@"

# Named pipes rather than coproc: bash unsets a coproc's variables the moment it
# exits, which would abort this script under set -u if bosun.exe failed early.
pipes="$(mktemp -d)" || die "cannot create a temp folder"
mkfifo "$pipes/in" "$pipes/out"
SECONDS=0  # One deadline covers both the slot wait and the guest memory wait.
"$EXE" acquire "${args[@]}" <"$pipes/in" >"$pipes/out" &
hold_pid=$!
exec 3>"$pipes/in" 4<"$pipes/out"
rm -rf "$pipes"

reply=""
read -r reply <&4
reply="${reply%$'\r'}"
if [ "${reply%% *}" != "acquired" ]; then
  echo "[bosun] slot service unavailable, running without a slot" >&2
  exec 3>&- 4<&-
  BOSUN_SLOT=-1 exec "$@"
fi
SLOT="${reply##* }"

# The VM has its own ceiling that Windows cannot see, so wait for guest memory too.
# Slot 0 means nothing else is running ahead of this job, and -1 means the deadline already passed.
if [ "$SLOT" != "0" ] && [ "$SLOT" != "-1" ]; then
  announced=""
  while [ "$(guest_avail_mb)" -lt "$MIN_GUEST_MB" ]; do
    [ -z "$announced" ] && echo "[bosun] waiting for WSL memory ($(guest_avail_mb) MB available)" >&2
    announced=1
    if [ "$MAX_WAIT" -gt 0 ] && [ "$SECONDS" -ge "$MAX_WAIT" ]; then
      echo "[bosun] waited ${SECONDS} s, starting anyway" >&2
      break
    fi
    sleep 2
  done
fi

# WSLENV carries the marker to any Windows program, so a nested run there passes through too.
export BOSUN_SLOT="$SLOT"
export WSLENV="${WSLENV:+$WSLENV:}BOSUN_SLOT"

case "$MAX_WRITE_GB" in ''|*[!0-9]*) die "--max-write-gb must be a whole number of GB" ;; esac

# The job runs in its own transient scope, so its whole tree is known: whatever it leaves behind is stopped when it
# ends, as the job object does on Windows, and what the tree writes is counted against the budget. A command that
# writes without end would otherwise fill the WSL disk image, and the Windows drive it lives on.
unit="bosun-job-$$-$RANDOM"
scope=""
# --expand-environment=no keeps the command byte-exact: systemd-run would otherwise expand $VAR and $$ in its arguments.
# A systemd too old to have it (before 254) runs the job without a scope, as before.
if command -v systemd-run >/dev/null && systemctl --user show-environment >/dev/null 2>&1 &&
  systemd-run --help 2>/dev/null | grep -q -- --expand-environment; then
  scope="/sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/app.slice/$unit.scope"
  launch=(systemd-run --user --scope --quiet --collect --expand-environment=no --unit="$unit" -p IOAccounting=yes --)
else
  launch=()
fi
over="$(mktemp)" || die "cannot create a temp file"
watch_pid=""
if [ -n "$scope" ] && [ "$MAX_WRITE_GB" -gt 0 ]; then
  (
    budget=$((MAX_WRITE_GB * 1073741824))
    for _ in $(seq 50); do [ -e "$scope/cgroup.procs" ] && break; sleep 0.1; done
    if [ ! -e "$scope/io.stat" ]; then
      # The user manager is only given the io controller by a root setting, so say once per boot how to turn it on.
      warned="${XDG_RUNTIME_DIR:-/tmp}/bosun-io-warned"
      if [ -e "$scope/cgroup.procs" ] && [ ! -e "$warned" ]; then
        : >"$warned"
        echo "[bosun] the write budget is off in WSL because systemd doesn't give user jobs the io controller. Turn it on once with: sudo $HOME/.local/share/bosun/enable-write-budget.sh" >&2
      fi
      exit 0
    fi
    while [ -e "$scope/cgroup.procs" ]; do
      written=$(awk '{for (i = 2; i <= NF; i++) if ($i ~ /^wbytes=/) { sub(/wbytes=/, "", $i); s += $i }} END {printf "%.0f", s + 0}' "$scope/io.stat" 2>/dev/null)
      if [ "${written:-0}" -gt "$budget" ]; then
        echo over >"$over"
        echo 1 >"$scope/cgroup.kill"
        exit 0
      fi
      sleep 1
    done
  ) 3>&- 4<&- &
  watch_pid=$!
fi

# The command must not inherit the pipe, or a daemon it starts would hold the slot for good.
# pdeathsig ends the command if this script dies, so a freed slot means the work has stopped.
if command -v setpriv >/dev/null; then
  setpriv --pdeathsig TERM -- "${launch[@]}" "$@" 3>&- 4<&-
else
  "${launch[@]}" "$@" 3>&- 4<&-
fi
code=$?
# Anything the command started and left running ends with it, so nothing it began can keep writing.
[ -n "$scope" ] && [ -e "$scope/cgroup.kill" ] && echo 1 >"$scope/cgroup.kill" 2>/dev/null
[ -n "$watch_pid" ] && { kill "$watch_pid" 2>/dev/null; wait "$watch_pid" 2>/dev/null; }
if [ -s "$over" ]; then
  echo "[bosun] stopped the command and everything it started: together they wrote more than $MAX_WRITE_GB GB (--max-write-gb). Something in it writes without a limit." >&2
  code=74
fi
rm -f "$over"
exec 3>&- 4<&-
wait "$hold_pid" 2>/dev/null
exit "$code"
