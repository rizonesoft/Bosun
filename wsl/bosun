#!/bin/bash
# WSL front end for bosun. Windows and WSL jobs share the same slots.
# Holding a slot means keeping a bosun.exe acquire process alive on a pipe.
# When this script ends for any reason the pipe closes and the slot frees.
set -u

die() { echo "[bosun] $*" >&2; exit 64; }

# The installed file supplies defaults; an explicit BOSUN_EXE still wins.
explicit_exe="${BOSUN_EXE:-}"
[ -r "$HOME/.config/bosun/env" ] && . "$HOME/.config/bosun/env"
EXE="${explicit_exe:-${BOSUN_EXE:-bosun.exe}}"
export BOSUN_EXE="$EXE"  # A nested shim must use the same executable.
MAX_WRITE_GB="${BOSUN_MAX_WRITE_GB:-100}"

guest_avail_mb() { awk '/^MemAvailable:/ {print int($2/1024)}' /proc/meminfo; }
# A whole number read as bosun.exe reads one (dm::parse_count): digits only, leading zeros allowed, at most $4, put
# in the variable $1 as plain decimal, so 08 is eight and never an arithmetic error. $2 names it in the refusal.
whole() {
  local v="$3"
  case "$v" in ''|*[!0-9]*) die "$2 must be a whole number" ;; esac
  v="${v#"${v%%[!0]*}"}"
  v="${v:-0}"
  { [ "${#v}" -le 13 ] && [ "$v" -le "$4" ]; } || die "$2 is too large (at most $4)"
  printf -v "$1" '%s' "$v"
}
guest_total_mb() { awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo; }

# A limit from a Linux variable ($1), printed as plain decimal when it is a whole number from $2 to $3; a bad one is
# said and skipped, so that one limit falls back to config.json or its default (D01 T01 §5), as bosun.exe does.
env_limit() {
  local v="${!1:-}"
  [ -n "$v" ] || return 1
  case "$v" in *[!0-9]*) echo "[bosun] ignoring $1=$v: not a whole number" >&2; return 1 ;; esac
  v="${v#"${v%%[!0]*}"}"
  v="${v:-0}"
  if [ "${#v}" -gt 13 ] || [ "$v" -lt "$2" ] || [ "$v" -gt "$3" ]; then
    echo "[bosun] ignoring $1=${!1}: not from $2 to $3" >&2
    return 1
  fi
  printf '%s' "$v"
}

# Linux variables do not reach bosun.exe by themselves, so the valid ones travel as flags, the same ones for run and
# status, and flags from the command line come later and win. A limit no variable sets bosun.exe takes from
# config.json itself; the wait and guest floor the shim needs for its own guest-memory wait it asks for (config_limits).
args=()
MAX_WAIT=""
MIN_GUEST_MB=""
OR_SKIP=""
NS="Bosun"
v="$(env_limit BOSUN_SLOTS 1 64)" && args+=(--slots "$v")
v="$(env_limit BOSUN_MIN_AVAIL_MB 0 1099511627776)" && args+=(--min-avail-mb "$v")
v="$(env_limit BOSUN_MAX_WAIT 0 604800)" && MAX_WAIT="$v"
v="$(env_limit BOSUN_MIN_GUEST_MB 0 1099511627776)" && MIN_GUEST_MB="$v"

# The wait and guest floor no variable or flag set, from config.json or the defaults, in one call to bosun.exe (the
# same resolution it makes for itself); when it can't answer, the shim's own defaults, said once.
config_limits() {
  local need=() out k val
  [ -n "$MAX_WAIT" ] || need+=(max_wait_s)
  [ -n "$MIN_GUEST_MB" ] || need+=(min_guest_mb)
  [ "${#need[@]}" -gt 0 ] || return 0
  if out="$("$EXE" config get "${need[@]}" 2>/dev/null)"; then
    while IFS='=' read -r k val; do
      val="${val%$'\r'}"
      case "$k" in
        max_wait_s) [ -n "$MAX_WAIT" ] || MAX_WAIT="$val" ;;
        min_guest_mb) [ -n "$MIN_GUEST_MB" ] || MIN_GUEST_MB="$val" ;;
      esac
    done <<<"$out"
  fi
  if [ -z "$MAX_WAIT" ] || [ -z "$MIN_GUEST_MB" ]; then
    echo "[bosun] can't read the saved limits through $EXE config get, so this job uses the defaults" >&2
  fi
  MAX_WAIT="${MAX_WAIT:-900}"
  MIN_GUEST_MB="${MIN_GUEST_MB:-3072}"
}

# The WSL logger is the bosun-log.service user unit wsl/install.sh sets up: asked of systemd, so no other process that
# merely mentions bosun_log.py counts. Without a user systemd it can't be told.
wsl_logger() {
  if ! command -v systemctl >/dev/null || ! systemctl --user show-environment >/dev/null 2>&1; then echo unknown; return; fi
  if systemctl --user is-active --quiet bosun-log.service; then echo running; else echo stopped; fi
}

# status adds this side's own figures (D01 T01 §3), which Windows can't see, so bosun.exe writes the one object.
if [ "${1:-}" = "status" ]; then
  shift
  [ -n "$MIN_GUEST_MB" ] && args+=(--min-guest-mb "$MIN_GUEST_MB")  # else bosun.exe takes it from config.json
  exec "$EXE" status "${args[@]}" --guest-avail-mb "$(guest_avail_mb)" --guest-total-mb "$(guest_total_mb)" \
    --wsl-logger "$(wsl_logger)" "$@"
fi
# config resolves the same Linux variables its jobs honour (completion review of D01 T01 §5): they cross to bosun.exe
# through WSLENV, so it says a bad one and reports what a job here would use.
if [ "${1:-}" = "config" ]; then
  for name in BOSUN_SLOTS BOSUN_MIN_AVAIL_MB BOSUN_MAX_WAIT BOSUN_MIN_GUEST_MB; do
    [ -n "${!name:-}" ] && export "$name" && WSLENV="${WSLENV:+$WSLENV:}$name"
  done
  export WSLENV
  exec "$EXE" "$@"
fi
# instances lists this side's agents, editors and jobs (D03 T02 §1) from /proc, by the rules bosun.exe uses on Windows.
if [ "${1:-}" = "instances" ]; then
  shift
  exec python3 -I "${BOSUN_LOG_PY:-$HOME/.local/share/bosun/bosun_log.py}" instances "$@"
fi
[ "${1:-}" = "run" ] || exec "$EXE" "$@"
shift
while [ $# -gt 0 ] && [ "$1" != "--" ]; do
  case "$1" in
    --max-wait) [ $# -ge 2 ] || die "--max-wait needs a value"; whole MAX_WAIT --max-wait "$2" 1099511627776; shift 2 ;;
    --min-guest-mb) [ $# -ge 2 ] || die "--min-guest-mb needs a value"; whole MIN_GUEST_MB --min-guest-mb "$2" 1099511627776; shift 2 ;;
    --max-write-gb) [ $# -ge 2 ] || die "--max-write-gb needs a value"; MAX_WRITE_GB="$2"; shift 2 ;;
    --or-skip) OR_SKIP=1; args+=(--or-skip); shift ;;
    --ns) [ $# -ge 2 ] || die "--ns needs a value"; case "$2" in ''|*';'*) die "--ns takes a name without ;" ;; esac; NS="$2"; args+=(--ns "$2"); shift 2 ;;
    --slots|--min-avail-mb) [ $# -ge 2 ] || die "$1 needs a value"; args+=("$1" "$2"); shift 2 ;;
    *) die "unknown option $1" ;;
  esac
done
[ "${1:-}" = "--" ] || die "usage: bosun run [options] -- command [args]"
shift
[ $# -gt 0 ] || die "usage: bosun run [options] -- command [args]"
whole MAX_WRITE_GB --max-write-gb "$MAX_WRITE_GB" 8589934591  # bash's signed 64 bits must hold it in bytes

# Says a thing once per boot, so a missing protection is reported without filling every job's output.
warn_once() {
  local mark="${XDG_RUNTIME_DIR:-/tmp}/bosun-warned-$1"
  [ -e "$mark" ] && return
  : >"$mark" 2>/dev/null
  echo "[bosun] $2" >&2
}

# Runs the command in its own transient scope, so its whole tree is known: whatever it leaves behind is stopped when it
# ends, as the job object does on Windows, and what the tree writes to the Linux disk is counted against the budget. A
# command that writes without end would otherwise fill the WSL disk image, and the Windows drive it lives on. Every path
# runs through here, a nested run and one without a slot included: a slot is about memory, containment about the work.
contained() {
  local unit="bosun-job-$$-$RANDOM" scope="" state watch_pid="" code
  local -a launch=()
  # A run inside another job's scope stays in it, so the outer job keeps counting and stopping all of its work: a
  # sibling scope of its own would escape both.
  if grep -q '/bosun-job-[^/]*\.scope$' /proc/self/cgroup 2>/dev/null; then
    "$@" 3>&- 4<&-
    return $?
  fi
  # --expand-environment=no keeps the command byte-exact: systemd-run would otherwise expand $VAR and $$ in it.
  if command -v systemd-run >/dev/null && systemctl --user show-environment >/dev/null 2>&1 &&
    systemd-run --help 2>/dev/null | grep -q -- --expand-environment; then
    # bosun-jobs.slice holds Bosun's jobs and nothing else, so the pressure monitor (wsl/bosun_log.py) can lower one
    # limit and throttle only them: app.slice holds every user service and application. Its cgroup is
    # bosun.slice/bosun-jobs.slice, because systemd nests a slice by the dashes in its name.
    scope="/sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service/bosun.slice/bosun-jobs.slice/$unit.scope"
    launch=(systemd-run --user --scope --quiet --collect --expand-environment=no --slice=bosun-jobs.slice --unit="$unit" -p IOAccounting=yes --)
  else
    warn_once noscope "jobs run without containment in WSL: no systemd user session with systemd 254 or later, so a child a job leaves behind keeps running and the write budget is off"
  fi
  state="$(mktemp -d)" || die "cannot create a temp folder"
  if [ -n "$scope" ] && [ "$MAX_WRITE_GB" -gt 0 ]; then
    (
      budget=$((MAX_WRITE_GB * 1073741824))
      # Waits for the scope for as long as the command runs, however slowly systemd starts it.
      until [ -e "$scope/cgroup.procs" ]; do [ -e "$state/done" ] && exit 0; sleep 0.1; done
      if [ ! -e "$scope/io.stat" ]; then
        warn_once noio "the write budget is off in WSL because systemd doesn't give user jobs the io controller. Turn it on once with: sudo $HOME/.local/share/bosun/enable-write-budget.sh"
        exit 0
      fi
      while [ -e "$scope/cgroup.procs" ] && [ ! -e "$state/done" ]; do
        written=$(awk '{for (i = 2; i <= NF; i++) if ($i ~ /^wbytes=/) { sub(/wbytes=/, "", $i); s += $i }} END {printf "%.0f", s + 0}' "$scope/io.stat" 2>/dev/null)
        if [ "${written:-0}" -gt "$budget" ]; then
          : >"$state/over"
          echo 1 >"$scope/cgroup.kill"
          exit 0
        fi
        sleep 1
      done
    ) 3>&- 4<&- &
    watch_pid=$!
  fi
  # The command must not inherit the pipe, or a daemon it starts would hold the slot for good.
  # pdeathsig ends the command if this script dies, so a freed slot means the work has stopped.
  if command -v setpriv >/dev/null; then
    setpriv --pdeathsig TERM -- "${launch[@]}" "$@" 3>&- 4<&-
  else
    "${launch[@]}" "$@" 3>&- 4<&-
  fi
  code=$?
  : >"$state/done"
  # Anything the command started and left running ends with it, so nothing it began can keep writing.
  [ -n "$scope" ] && [ -e "$scope/cgroup.kill" ] && echo 1 >"$scope/cgroup.kill" 2>/dev/null
  [ -n "$watch_pid" ] && wait "$watch_pid" 2>/dev/null
  if [ -e "$state/over" ]; then
    echo "[bosun] stopped the command and everything it started: together they wrote more than $MAX_WRITE_GB GB (--max-write-gb). Something in it writes without a limit." >&2
    code=74
  fi
  rm -rf "$state"
  return "$code"
}

# Already inside a slot of this namespace (BOSUN_NS lists those the job holds, joined by ;, and an older marker has none
# and always passes), so a script calling itself cannot deadlock. A job in another namespace takes its place there. A run started from Windows arrives here too, and
# the Windows job can't see what Linux processes write, so it is contained on this side.
if [ -n "${BOSUN_SLOT:-}" ] && { [[ ";${BOSUN_NS:-};" == *";$NS;"* ]] ||
    { [ -z "$OR_SKIP" ] && { [ -z "${BOSUN_NS:-}" ] || [ "$BOSUN_SLOT" = "-1" ]; }; }; }; then
  contained "$@"
  exit $?
fi

config_limits
args+=(--max-wait "$MAX_WAIT" --min-guest-mb "$MIN_GUEST_MB")  # acquire puts the guest floor in the holder's record

# What the job's record names (D01 T01 §1): this side, the command with each word quoted as the shell reads it back,
# and the Git top level of the working folder when there is one. bosun.exe acquire writes the record, as it holds the slot.
# At most 4096 characters, cut with " [...]": Linux accepts argument lists past the Windows command-line limit, and a
# label that made bosun.exe's command line too long would make Windows refuse the acquire, running the job unqueued.
label="$(printf '%q ' "$@")"
label="${label% }"
[ "${#label}" -gt 4096 ] && label="${label:0:4090} [...]"
args+=(--side wsl --label "$label")
# Found as bosun.exe finds a Windows job's, the nearest folder up holding .git, so no Linux git is needed (where there is
# none, `git` on the PATH is Windows Git through interop, which names the folder by its \\wsl.localhost path).
dir="$PWD"
while :; do
  if [ -e "$dir/.git" ]; then args+=(--repo "$dir"); break; fi
  [ "$dir" = "/" ] || [ -z "$dir" ] && break
  dir="$(dirname "$dir")"
done

# Named pipes rather than coproc: bash unsets a coproc's variables the moment it
# exits, which would abort this script under set -u if bosun.exe failed early.
pipes="$(mktemp -d)" || die "cannot create a temp folder"
mkfifo "$pipes/in" "$pipes/out"
# One deadline covers both the slot wait and the guest memory wait, kept in milliseconds: bash's SECONDS counts whole
# wall-clock seconds from when it was set, so a three second wait could end after barely two.
now_ms() {
  local t="${EPOCHREALTIME:-}"
  t="${t//[!0-9]/}"  # the decimal separator follows the locale
  if [ -n "$t" ]; then echo $((10#$t / 1000)); else date +%s%3N; fi
}
began_ms="$(now_ms)"
# acquire runs in a session of its own: the hangup a dying terminal sends its process group would otherwise end it with
# this script, before it could write the job's line (D01 T01 §2). It still ends when the pipe closes.
detach=()
command -v setsid >/dev/null && detach=(setsid)
# --guest-pid and --guest-distro name this shim's own process in the holder's record, so the instance scanners join the
# job's two halves (a Linux pid is unique only within one distro). A distro name bosun.exe wouldn't take is left out.
guest=(--guest-pid "$$")
[[ "${WSL_DISTRO_NAME:-}" =~ ^[A-Za-z0-9._-]{1,64}$ ]] && guest+=(--guest-distro "$WSL_DISTRO_NAME")
"${detach[@]}" "$EXE" acquire "${args[@]}" --queued-at-ms "$began_ms" "${guest[@]}" <"$pipes/in" >"$pipes/out" &
hold_pid=$!
exec 3>"$pipes/in" 4<"$pipes/out"
rm -rf "$pipes"

reply=""
read -r reply <&4
reply="${reply%$'\r'}"
if [ "$reply" = "skipped" ] || { [ -n "$OR_SKIP" ] && [ "${reply%% *}" != "acquired" ]; }; then
  # --or-skip never starts a job without its place, so a slot service that can't answer skips it too, and says so.
  [ "$reply" = "skipped" ] || echo "[bosun] slot service unavailable, not started" >&2
  exec 3>&- 4<&-
  exit 75
fi
if [ "${reply%% *}" != "acquired" ]; then
  echo "[bosun] slot service unavailable, running without a slot" >&2
  exec 3>&- 4<&-
  BOSUN_SLOT=-1 contained "$@"
  exit $?
fi
SLOT="${reply##* }"

# The VM has its own ceiling that Windows cannot see, so wait for guest memory too.
# Slot 0 means nothing else is running ahead of this job, and -1 means the deadline already passed.
if [ "$SLOT" != "0" ] && [ "$SLOT" != "-1" ]; then
  announced=""
  while [ "$(guest_avail_mb)" -lt "$MIN_GUEST_MB" ]; do
    [ -z "$announced" ] && echo "[bosun] waiting for WSL memory ($(guest_avail_mb) MB available)" >&2
    announced=1
    waited_ms=$(( $(now_ms) - began_ms ))
    [ -n "$OR_SKIP" ] && ! kill -0 "$hold_pid" 2>/dev/null && break  # the place is lost: refused below
    if [ "$MAX_WAIT" -gt 0 ] && [ "$waited_ms" -ge $((MAX_WAIT * 1000)) ]; then
      if [ -n "$OR_SKIP" ]; then
        echo "[bosun] waited $((waited_ms / 1000)) s, not started (WSL memory)" >&2
        ( echo skip >&3 ) 2>/dev/null
        exec 3>&- 4<&-
        exit 75
      fi
      echo "[bosun] waited $((waited_ms / 1000)) s, starting anyway" >&2
      break
    fi
    sleep 2
  done
fi

# WSLENV carries the marker to any Windows program, so a nested run there passes through too.
export BOSUN_SLOT="$SLOT"
[ "$SLOT" = "-1" ] || export BOSUN_NS="${BOSUN_NS:+$BOSUN_NS;}$NS"
export WSLENV="${WSLENV:+$WSLENV:}BOSUN_SLOT:BOSUN_NS"

# bosun.exe acquire writes the job's line (D01 T01 §2): it learns when the command started, after any wait for guest
# memory, and how it ended. A pipe that's gone only loses the line: each message is sent from a subshell, so the
# SIGPIPE of a dead acquire ends that subshell, never this script or the command's exit code.
# With --or-skip a lost acquire has also lost the place, so the job doesn't start.
if ! ( kill -0 "$hold_pid" && echo start >&3 ) 2>/dev/null && [ -n "$OR_SKIP" ]; then
  echo "[bosun] the place was lost, not started" >&2
  exec 3>&- 4<&-
  exit 75
fi
contained "$@"
code=$?
( echo "exit $code" >&3 ) 2>/dev/null
exec 3>&- 4<&-
wait "$hold_pid" 2>/dev/null
exit "$code"
