#!/bin/sh
# Pull the private overlay in .private after a pull of this repository merges or fast-forwards (D00 T05 §2).
# Only the overlay's own clone, marked by scripts/setup-clone.ps1 (bosun.overlay = true), inside this checkout and
# with a clean working tree, is pulled, and only as a fast-forward that never replaces an ignored file. Every outcome
# is one line, and the merge itself never fails here. An already up to date pull, or one that rebases, runs no
# post-merge hook: scripts/sync.ps1 updates both then.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
# Git gives a hook the public repository's own variables, and `git -C` does not override them: without this, the
# commands below would read and pull the public repository instead of the overlay.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX
# However the hook ends, the checkout's CLAUDE.local.md is brought in line with the overlay as it now is: it imports
# .private/AGENTS.md only while .private is the marked overlay holding it (D00 T05 §5). Without pwsh it is left as is.
update_rules() {
    if command -v pwsh >/dev/null 2>&1; then
        pwsh -NoProfile -NonInteractive -File "$root/scripts/update-agent-rules.ps1" -Repo "$root" 2>/dev/null
    fi
}
trap update_rules EXIT
overlay="$root/.private"
[ -e "$overlay/.git" ] || exit 0

say() { echo "overlay: $*"; }

# The one rule for what counts as the overlay's own clone, as in scripts/setup-clone.ps1: .private and its .git are
# real folders at their own paths (no link, junction, or .git file of a linked worktree or submodule). Anything else may
# belong to another checkout: not pulled. (Setup also asks git for the clone's git folder; here the paths decide.)
here=$(cd "$root" 2>/dev/null && pwd -P)
if [ ! -d "$overlay/.git" ]; then
    say "not pulled: .private is a linked worktree or submodule, not a clone of its own"
    exit 0
fi
if [ -h "$overlay" ] || [ -h "$overlay/.git" ] ||
    [ "$(cd "$overlay" 2>/dev/null && pwd -P)" != "$here/.private" ] ||
    [ "$(cd "$overlay/.git" 2>/dev/null && pwd -P)" != "$here/.private/.git" ]; then
    say "not pulled: .private, or its .git, is a link to another folder"
    exit 0
fi


# The mark is read from .private's own config only, never a user or system one that would mark every checkout.
if [ "$(git -C "$overlay" config --local --get bosun.overlay 2>/dev/null)" != "true" ]; then
    say "not pulled: .private is not marked as the overlay (pwsh scripts/setup-clone.ps1 marks a checkout of it)"
    exit 0
fi
# Untracked files asked for outright, so a status.showUntrackedFiles setting can't hide one; "normal" names a new
# folder once rather than every file in it, which is all the clean check needs.
if ! status=$(git -C "$overlay" status --porcelain --untracked-files=normal 2>/dev/null); then
    say "not pulled: git cannot read .private"
    exit 0
fi
if [ -n "$status" ]; then
    # The retry given keeps the hook's own protection: a plain pull would replace an ignored file.
    say "not pulled: .private has uncommitted changes; commit or stash them, then: git -C .private fetch && git -C .private merge --ff-only --no-overwrite-ignore @{u}"
    exit 0
fi
# No fetch's or merge's own output is shown: a remote's message can name a URL with a credential in it.
# Only the one branch needed is fetched, by an explicit refspec with an empty --refmap, so no configured refspec or
# mapping (one into a tag would overwrite local tags), prune or pruneTags setting applies, and no tag is fetched.
fetch_branch() {
    git -C "$overlay" fetch --quiet --no-prune --no-tags --refmap= "$1" "+refs/heads/$2:refs/remotes/$1/$2" >/dev/null 2>&1
}
# The full name, with refs/heads/ taken off: --short abbreviates to heads/main when a tag is also called main.
branch=$(git -C "$overlay" symbolic-ref --quiet HEAD 2>/dev/null)
branch=${branch#refs/heads/}
remote=$(git -C "$overlay" config --local --get "branch.$branch.remote" 2>/dev/null)
upstream=$(git -C "$overlay" config --local --get "branch.$branch.merge" 2>/dev/null)
upstream=${upstream#refs/heads/}
if ! git -C "$overlay" rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
    # A clone of the overlay while it was still empty has no commit and no upstream. Once its first commit is pushed,
    # its branch is the remote's default as the remote reports it, whatever the unborn branch was called.
    default=$(git -C "$overlay" ls-remote --symref origin HEAD 2>/dev/null | sed -n 's|^ref: refs/heads/\([^[:space:]]*\)[[:space:]]*HEAD$|\1|p')
    if [ -n "$default" ] && fetch_branch origin "$default" &&
        target=$(git -C "$overlay" rev-parse --verify --quiet "refs/remotes/origin/$default" 2>/dev/null); then
        # The upstream is recorded before the checkout, so a run stopped between the two retries cleanly.
        if git -C "$overlay" config --local "branch.$default.remote" origin &&
            git -C "$overlay" config --local "branch.$default.merge" "refs/heads/$default" &&
            git -C "$overlay" checkout --quiet --no-overwrite-ignore -b "$default" "$target" >/dev/null 2>&1; then
            say "updated to $(git -C "$overlay" rev-parse --short HEAD 2>/dev/null), its first commit; to undo its upstream setting: git -C .private config --unset branch.$default.remote; git -C .private config --unset branch.$default.merge"
        else
            say "not pulled: .private could not take its first commit; see: git -C .private status"
        fi
        exit 0
    fi
    say "not pulled: .private has no upstream branch yet"
    exit 0
fi
if [ -z "$branch" ] || [ -z "$remote" ] || [ "$remote" = "." ] || [ -z "$upstream" ]; then
    say "not pulled: .private has no upstream branch"
    exit 0
fi
before=$(git -C "$overlay" rev-parse HEAD 2>/dev/null)
tracking="refs/remotes/$remote/$upstream"
# A fast-forward that refuses to replace an ignored local file (a plain pull would overwrite one), with any
# branch.<name>.mergeOptions (a squash) and autostash set aside. Each failure has its own line.
if ! fetch_branch "$remote" "$upstream"; then
    say "not pulled: .private's remote could not be reached, or its branch is gone; see: git -C .private fetch"
elif ! git -C "$overlay" -c "branch.$branch.mergeOptions=" -c merge.autoStash=false merge --ff-only --no-overwrite-ignore --no-squash --quiet "$tracking" >/dev/null 2>&1; then
    if [ -z "$(git -C "$overlay" rev-list --max-count=1 "$tracking..HEAD" 2>/dev/null)" ]; then
        say "not pulled: an incoming file would replace an ignored file in .private; move it aside, then: git -C .private merge --ff-only --no-overwrite-ignore $tracking"
    else
        say "not pulled: .private has commits of its own that its remote lacks (it has diverged); see: git -C .private log $tracking..HEAD"
    fi
elif ! git -C "$overlay" merge-base --is-ancestor "$tracking" HEAD >/dev/null 2>&1; then
    say "not pulled: the fast-forward did not reach its upstream (a git setting changed it); see: git -C .private status"
elif [ "$(git -C "$overlay" rev-parse HEAD 2>/dev/null)" != "$(git -C "$overlay" rev-parse "$tracking" 2>/dev/null)" ]; then
    say "up to date, and ahead of its upstream by $(git -C "$overlay" rev-list --count "$tracking..HEAD" 2>/dev/null); pwsh scripts/sync.ps1 pushes it"
else
    after=$(git -C "$overlay" rev-parse HEAD 2>/dev/null)
    if [ "$before" = "$after" ]; then
        say "already current"
    else
        say "updated to $(git -C "$overlay" rev-parse --short HEAD 2>/dev/null)"
    fi
fi
exit 0