#!/bin/sh
# Pull the private overlay in .private after a pull of this repository merges or fast-forwards (D00 T05 §2).
# Only the overlay's own clone, marked by scripts/setup-clone.ps1 (bosun.overlay = true), inside this checkout and
# with a clean working tree, is pulled, and only as a fast-forward that never replaces an ignored file. Every outcome
# is one line, and the merge itself never fails here. An already up to date pull, or one that rebases, runs no
# post-merge hook: scripts/sync.ps1 updates both then.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
overlay="$root/.private"
[ -e "$overlay/.git" ] || exit 0

say() { echo "overlay: $*"; }

# The overlay is a clone with its own .git folder. A linked worktree or a submodule has a .git file instead, and shares
# its config (the mark included) with another checkout: never pulled.
if [ ! -d "$overlay/.git" ]; then
    say "not pulled: .private is a linked worktree or submodule, not the overlay's own clone"
    exit 0
fi

# A link (a junction or symbolic link) leads to a folder another checkout may own: never followed.
if [ -h "$overlay" ] || [ "$(cd "$overlay" 2>/dev/null && pwd -P)" != "$(cd "$root" 2>/dev/null && pwd -P)/.private" ]; then
    say "not pulled: .private is a link to another folder, not the overlay"
    exit 0
fi

# Git gives a hook the public repository's own variables, and `git -C` does not override them: without this, the
# commands below would read and pull the public repository instead of the overlay.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX

# The mark is read from .private's own config only, never a user or system one that would mark every checkout.
if [ "$(git -C "$overlay" config --local --get bosun.overlay 2>/dev/null)" != "true" ]; then
    say "not pulled: .private is not marked as the overlay (pwsh scripts/setup-clone.ps1 marks a checkout of it)"
    exit 0
fi
# Untracked files asked for outright, so a status.showUntrackedFiles setting can't hide one.
if ! status=$(git -C "$overlay" status --porcelain --untracked-files=all 2>/dev/null); then
    say "not pulled: git cannot read .private"
    exit 0
fi
if [ -n "$status" ]; then
    say "not pulled: .private has uncommitted changes; commit or stash them, then: git -C .private pull --ff-only"
    exit 0
fi
# The pull's own output is not shown: a remote's message can name a URL with a credential in it.
if ! git -C "$overlay" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    # A clone of the overlay while it was still empty has no commit and no upstream. Once its first commit is
    # pushed, the branch is taken from origin and tracked from then on.
    branch=$(git -C "$overlay" symbolic-ref --quiet --short HEAD 2>/dev/null)
    if [ -n "$branch" ] && ! git -C "$overlay" rev-parse --verify --quiet HEAD >/dev/null 2>&1 &&
        git -C "$overlay" fetch --quiet origin >/dev/null 2>&1 &&
        git -C "$overlay" rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null 2>&1; then
        if git -C "$overlay" merge --ff-only --no-overwrite-ignore --quiet "refs/remotes/origin/$branch" >/dev/null 2>&1 &&
            git -C "$overlay" branch --quiet --set-upstream-to="origin/$branch" >/dev/null 2>&1; then
            say "updated to $(git -C "$overlay" rev-parse --short HEAD 2>/dev/null), its first commit"
        else
            say "not pulled: .private could not take its first commit; see: git -C .private status"
        fi
        exit 0
    fi
    say "not pulled: .private has no upstream branch yet"
    exit 0
fi
before=$(git -C "$overlay" rev-parse HEAD 2>/dev/null)
# Fetch, then a fast-forward that refuses to replace an ignored local file (a plain pull would overwrite one).
if git -C "$overlay" fetch --quiet >/dev/null 2>&1 && git -C "$overlay" merge --ff-only --no-overwrite-ignore --quiet '@{u}' >/dev/null 2>&1; then
    after=$(git -C "$overlay" rev-parse HEAD 2>/dev/null)
    if [ "$before" = "$after" ]; then
        say "already current"
    else
        say "updated to $(git -C "$overlay" rev-parse --short HEAD 2>/dev/null)"
    fi
else
    say "not pulled: .private could not be fast-forwarded (it has diverged, or its remote cannot be reached); see: git -C .private status"
fi
exit 0
